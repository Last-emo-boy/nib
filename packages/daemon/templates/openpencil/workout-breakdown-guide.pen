 SC","fontSize":42,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"frame","id":"f138","name":"提醒列表","width":"fill_container","height":"fit_content","layout":"vertical","gap":16,"alignItems":"start","children":[{"type":"frame","id":"f130","name":"提醒项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":10,"alignItems":"start","children":[{"type":"text","content":"01","id":"t128","name":"提醒序号","width":56,"fill":"$c-accent","fontFamily":"Inter","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"练之前先花 3 分钟活动踝、髋、肩，别省。","id":"t129","name":"提醒文字","width":"fill_container","fill":"$c-inv-muted","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f133","name":"提醒项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":10,"alignItems":"start","children":[{"type":"text","content":"02","id":"t131","name":"提醒序号","width":56,"fill":"$c-accent","fontFamily":"Inter","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"动作做不满次数就减次数，不要减质量。","id":"t132","name":"提醒文字","width":"fill_container","fill":"$c-inv-muted","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f136","name":"提醒项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":10,"alignItems":"start","children":[{"type":"text","content":"03","id":"t134","name":"提醒序号","width":56,"fill":"$c-accent","fontFamily":"Inter","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"两次训练之间至少隔一天，肌肉是在休息时长的。","id":"t135","name":"提醒文字","width":"fill_container","fill":"$c-inv-muted","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f141","name":"署名行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"justifyContent":"space_between","alignItems":"center","children":[{"type":"text","content":"@ 你的账号名","id":"t139","name":"账号名","fill":"$c-card","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"},{"type":"text","content":"每周一套能在家做的训练","id":"t140","name":"更新说明","fill":"$c-inv-muted","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"}]}]}]}]}