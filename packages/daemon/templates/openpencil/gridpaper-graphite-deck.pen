"t80","name":"序号","width":528,"fill":"$c-faint","fontFamily":"Inter","fontSize":24,"lineHeight":1.45,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"},{"type":"text","content":"夜间照明仍在扩张","id":"t81","name":"小标题","width":"fill_container","fill":"$c-graphite","fontFamily":"Noto Sans SC","fontSize":36,"lineHeight":1.35,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"全球人工夜间照明面积每年\n增长约百分之二。三座城市的\n地面照度中位数十年间由\n5 lux 升至 12 lux。","id":"t82","name":"说明","width":"fill_container","fill":"$c-soft","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f87","name":"缺口 02","x":688,"y":384,"width":528,"height":"fit_content","layout":"vertical","gap":20,"alignItems":"start","children":[{"type":"text","content":"02","id":"t84","name":"序号","width":528,"fill":"$c-faint","fontFamily":"Inter","fontSize":24,"lineHeight":1.45,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"},{"type":"text","content":"觅食有数据，鸣唱没有","id":"t85","name":"小标题","width":"fill_container","fill":"$c-graphite","fontFamily":"Noto Sans SC","fontSize":36,"lineHeight":1.35,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"既有工作集中在觅食与迁徙\n时序；鸣唱起始时间只有零散\n记录，且多数未同步测量样\n点的实际照度。","id":"t86","name":"说明","width":"fill_container","fill":"$c-soft","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f91","name":"缺口 03","x":1264,"y":384,"width":528,"height":"fit_content","layout":"vertical","gap":20,"alignItems":"start","children":[{"type":"text","content":"03","id":"t88","name":"序号","width":528,"fill":"$c-faint","fontFamily":"Inter","fontSize":24,"lineHeight":1.45,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"},{"type":"text","content":"把两者同点同时量","id":"t89","name":"小标题","width":"fill_container","fill":"$c-graphite","fontFamily":"Noto Sans SC","fontSize":36,"lineHeight":1.35,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"本研究在同一样点同步记录\n地面照度与鸣唱起始时间，\n给出两者的剂量—反应关系，\n而不是相关系数。","id":"t90","name":"说明","width":"fill_container","fill":"$c-soft","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"rectangle","id":"r92","name":"细线","x":112,"y":960,"width":1680,"height":1,"fill":"$c-hair"},{"type":"frame","id":"f94","name":"引证槽","x":112,"y":984,"width":1240,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"[1] 陈黎 等，2024，城市生态学报，41(3): 217–229","id":"t93","name":"引证","width":"fill_container","fill":"$c-faint","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.45,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f96","name":"页码","x":1592,"y":984,"width":200,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"2 / 8","id":"t95","name":"页码","width":200,"fill":"$c-faint","fontFamily":"Inter","fontSize":24,"lineHeight":1.45,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"rectangle","id":"r97","name":"格线 · 竖","x":16,"y":0,"width":1,"height":1080,"fill":"$c-grid"},{"type":"rectangle","id":"r98","name":"格线 · 竖","x":64,"y":0,"width":1,"height":1080,"fill":"$c-grid"},{"type":"rectangle","id":"r99","name":"格线 · 竖","x":112,"y":0,"width":1,"height":1080,"fill":"$c-grid"},{"type":"rectangle","id":"r100","name":"格线 · 竖","x":160,"y":0,"width":1,"height":1080,"fill":"$c-grid"},{"type":"rectangle","id":"r101","name":"格线 · 竖","x":208,"y":0,"width":1,"height":1080,"fill":"$c-grid"},{"type":"rectangle","id":"r102","name":"格线 · 竖","x":256,"y":0,"width":1,"height":1080,"fill":"$c-grid"},{"type":"rectangle","id":"r103","name":"格线 · 竖","x":304,"y":0,"width":1,"height":1080,"fill":"$c-grid