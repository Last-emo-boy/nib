    "checkbox": {
      "template": "<Text as=\"label\" size=\"2\"{class}>\n  <Flex gap=\"2\">\n    <Checkbox defaultChecked />\n    {text:checkbox-label}\n  </Flex>\n</Text>",
      "imports": {
        "Checkbox": "@radix-ui/themes",
        "Flex": "@radix-ui/themes",
        "Text": "@radix-ui/themes"
