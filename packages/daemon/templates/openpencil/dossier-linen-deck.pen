n":[{"type":"text","content":"结论","id":"t252","name":"单元格文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.45,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"frame","id":"f253","name":"单元格","width":396,"height":"fit_content","layout":"vertical","gap":0,"padding":[16,24],"children":[{"type":"text","content":"不建议","id":"t254","name":"单元格文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.45,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"frame","id":"f255","name":"单元格","width":396,"height":"fit_content","layout":"vertical","gap":0,"padding":[16,24],"children":[{"type":"text","content":"备选","id":"t256","name":"单元格文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.45,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"frame","id":"f257","name":"单元格","width":396,"height":"fit_content","layout":"vertical","gap":0,"padding":[16,24],"children":[{"type":"text","content":"推荐","id":"t258","name":"单元格文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.45,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]}]},{"type":"rectangle","id":"r260","name":"细线","width":1584,"height":1,"fill":"$c-rule"}]},{"type":"text","content":"推荐方案丙。它是三者里唯一让「记录」成为流程副产品的一个，其余两个都还要靠人记得去做。","id":"t262","name":"推荐说明","width":1584,"fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f267","name":"编号段","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§4.1","id":"t265","name":"段号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.077,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f266","name":"段落","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"text","content":"成本按 240 家门店试算：甲需增编 11 人，年支出约 190 万；\n乙的报价随门店数线性上涨，丙在第二年起低于两者的一半。","id":"t264","name":"正文","width":900,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.8,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]}]}]},{"type":"frame","id":"f280","name":"05 方案对比 · 装订","width":1920,"height":1080,"layout":"none","children":[{"type":"rectangle","id":"r281","name":"装订孔","x":115,"y":264,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r282","name":"装订孔","x":115,"y":534,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r283","name":"装订孔","x":115,"y":804,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r284","name":"装订线","x":120,"y":0,"width":2,"height":1080,"fill":"$c-thread"}]}]},{"type":"frame","id":"f313","name":"06 逆向叙述","x":4080,"y":1440,"width":1920,"height":1080,"fill":"$c-linen","layout":"none","clip":true,"children":[{"type":"frame","id":"f301","name":"06 逆向叙述 · 正文","width":1920,"height":1080,"layout":"vertical","gap":40,"padding":[96,120,96,0],"justifyContent":"center","children":[{"type":"frame","id":"f307","name":"正文块","width":"fill_container","height":"fit_content","layout":"vertical","gap":0,"padding":[0,0,0,216],"children":[{"type":"frame","id":"f306","name":"页眉","width":"fill_container","height":"fit_content","layout":"horizontal","gap":48,"justifyContent":"space_between","alignItems":"start","children":[{"type":"text","content":"OPS-2026-041","id":"t302","name":"文档代号","fill":"$c-ink-faint","fontFamily":"Inter","fontSize":26,"lineHeight":1.5,"letterSpacing":2,"textGrowth":"auto","fontWeight":"500"},{"type":"frame","id":"f305","name":"骑缝页标","width":"fit_content","height":"fit_content","layout":"vertical","gap":10,"alignItems":"end","children":[{"type":"text","content":"p. 6 / 8","id":"t303","name":"页标","fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"},{"type":"rectangle","id":"r304","name":"细线","width":48,"height":1,"fill":"$c-rule"}]}]}]},{"type":"frame","id":"f300","name":"节","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"children":[{"type":"frame","id":"f298","name":"节标题行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§5","id":"t296","name":"节号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.115,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"text","content":"若此事已成","id":"t297","name":"节标题","width":1584,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":44,"lineHeight":1.25,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"frame","id":"f299","name":"节内容","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"children":[{"type":"frame","id":"f293","name":"编号段","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§5.1","id":"t291","name":"段号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.077,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f292","name":"段落","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"text","content":"到明年三月，每家门店在每个自然周都会留下完整的巡检记录。\n记录不再依赖谁记得拍照，而是由流程本身产生：\n检查项没有勾完，当天的巡检就不算结束。\n区域经理在周一早晨看到的不是一份汇总表，\n而是上周所有未闭环问题按门店排开的清单。\n我们不再讨论覆盖率，因为覆盖率恒等于百分之百；\n要讨论的是闭环时长，以及它为什么在某些门店偏长。","id":"t290","name":"正文","width":900,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.8,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f295","name":"正文块","width":"fill_container","height":"fit_content","layout":"vertical","gap":0,"padding":[0,0,0,216],"children":[{"type":"frame","id":"f294","name":"署名行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":0,"alignItems":"start","children":[{"type":"rectangle","id":"r289","name":"引语竖线","width":2,"height":132,"fill":"$c-thread"},{"type":"frame","id":"f288","name":"署名引语","width":"fill_container","height":"fit_content","layout":"vertical","gap":12,"padding":[0,0,0,36],"children":[{"type":"text","content":"把巡检做成一件不需要提醒的事，\n是这次改造真正的目标。","id":"t286","name":"引语","width":1100,"fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.6,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"},{"type":"text","content":"—— 项目组，2026 年 8 月","id":"t287","name":"引语署名","width":1100,"fill":"$c-ink-faint","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]}]}]}]},{"type":"frame","id":"f308","name":"06 逆向叙述 · 装订","width":1920,"height":1080,"layout":"none","children":[{"type":"rectangle","id":"r309","name":"装订孔","x":115,"y":264,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r310","name":"装订孔","x":115,"y":534,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r311","name":"装订孔","x":115,"y":804,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r312","name":"装订线","x":120,"y":0,"width":2,"height":1080,"fill":"$c-thread"}]}]},{"type":"frame","id":"f357","name":"07 疑问","x":0,"y":2880,"width":1920,"height":1080,"fill":"$c-linen","layout":"none","clip":true,"children":[{"type":"frame","id":"f345","name":"07 疑问 · 正文","width":1920,"height":1080,"layout":"vertical","gap":28,"padding":[96,120,96,0],"justifyContent":"start","children":[{"type":"frame","id":"f351","name":"正文块","width":"fill_container","height":"fit_content","layout":"vertical","gap":0,"padding":[0,0,0,216],"children":[{"type":"frame","id":"f350","name":"页眉","width":"fill_container","height":"fit_content","layout":"horizontal","gap":48,"justifyContent":"space_between","alignItems":"start","children":[{"type":"text","content":"OPS-2026-041","id":"t346","name":"文档代号","fill":"$c-ink-faint","fontFamily":"Inter","fontSize":26,"lineHeight":1.5,"letterSpacing":2,"textGrowth":"auto","fontWeight":"500"},{"type":"frame","id":"f349","name":"骑缝页标","width":"fit_content","height":"fit_content","layout":"vertical","gap":10,"alignItems":"end","children":[{"type":"text","content":"p. 7 / 8","id":"t347","name":"页标","fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"},{"type":"rectangle","id":"r348","name":"细线","width":48,"height":1,"fill":"$c-rule"}]}]}]},{"type":"frame","id":"f344","name":"节","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"frame","id":"f342","name":"节标题行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§6","id":"t340","name":"节号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.115,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"text","content":"已经被问到的四个问题","id":"t341","name":"节标题","width":1584,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":44,"lineHeight":1.25,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"frame","id":"f343","name":"节内容","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"frame","id":"f318","name":"编号段","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§6.1","id":"t316","name":"段号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.077,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f317","name":"段落","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"text","content":"问：全量记录会不会把巡检变成打卡？","id":"t314","name":"问","width":900,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"不会。检查项从 42 项压到 18 项，每项都要有照片或读数支撑，\n勾选式的应付会在抽核环节被直接退回。","id":"t315","name":"答","width":900,"fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.65,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f320","name":"正文块","width":"fill_container","height":"fit_content","layout":"vertical","gap":0,"padding":[0,0,0,216],"children":[{"type":"rectangle","id":"r319","name":"细线","width":1584,"height":1,"fill":"$c-rule"}]},{"type":"frame","id":"f325","name":"编号段","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§6.2","id":"t323","name":"段号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.077,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f324","name":"段落","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"text","content":"问：门店自检的结果可信吗？","id":"t321","name":"问","width":900,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"抽核比例定在 15%，由区域经理随机指定，结果与自检并列存档。\n连续两次抽核不一致的门店，恢复为人工巡检。","id":"t322","name":"答","width":900,"fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.65,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f327","name":"正文块","width":"fill_container","height":"fit_content","layout":"vertical","gap":0,"padding":[0,0,0,216],"children":[{"type":"rectangle","id":"r326","name":"细线","width":1584,"height":1,"fill":"$c-rule"}]},{"type":"frame","id":"f332","name":"编号段","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§6.3","id":"t330","name":"段号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.077,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f331","name":"段落","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"text","content":"问：需要门店多花多少时间？","id":"t328","name":"问","width":900,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"单次自检 12 分钟，比现行的纸质表单少 4 分钟。\n时间省在录入上，不省在检查上。","id":"t329","name":"答","width":900,"fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.65,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f334","name":"正文块","width":"fill_container","height":"fit_content","layout":"vertical","gap":0,"padding":[0,0,0,216],"children":[{"type":"rectangle","id":"r333","name":"细线","width":1584,"height":1,"fill":"$c-rule"}]},{"type":"frame","id":"f339","name":"编号段","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§6.4","id":"t337","name":"段号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.077,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f338","name":"段落","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"text","content":"问：这套记录会被用来考核门店吗？","id":"t335","name":"问","width":900,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"前两个季度只用于发现问题，不进考核。\n考核口径需要另行讨论，不在本备忘的范围内。","id":"t336","name":"答","width":900,"fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.65,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]}]}]},{"type":"frame","id":"f352","name":"07 疑问 · 装订","width":1920,"height":1080,"layout":"none","children":[{"type":"rectangle","id":"r353","name":"装订孔","x":115,"y":264,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r354","name":"装订孔","x":115,"y":534,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r355","name":"装订孔","x":115,"y":804,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r356","name":"装订线","x":120,"y":0,"width":2,"height":1080,"fill":"$c-thread"}]}]},{"type":"frame","id":"f412","name":"08 决议","x":2040,"y":2880,"width":1920,"height":1080,"fill":"$c-linen","layout":"none","clip":true,"children":[{"type":"frame","id":"f400","name":"08 决议 · 正文","width":1920,"height":1080,"layout":"vertical","gap":36,"padding":[96,120,96,0],"justifyContent":"start","children":[{"type":"frame","id":"f406","name":"正文块","width":"fill_container","height":"fit_content","layout":"vertical","gap":0,"padding":[0,0,0,216],"children":[{"type":"frame","id":"f405","name":"页眉","width":"fill_container","height":"fit_content","layout":"horizontal","gap":48,"justifyContent":"space_between","alignItems":"start","children":[{"type":"text","content":"OPS-2026-041","id":"t401","name":"文档代号","fill":"$c-ink-faint","fontFamily":"Inter","fontSize":26,"lineHeight":1.5,"letterSpacing":2,"textGrowth":"auto","fontWeight":"500"},{"type":"fram