{"version":"2.20","variables":{"c-bg":{"type":"color","value":"#FBF5F7"},"c-surface":{"type":"color","value":"#FFFFFF"},"c-band":{"type":"color","value":"#2C0F1D"},"c-band-muted":{"type":"color","value":"#B79AA5"},"c-ink":{"type":"color","value":"#23101A"},"c-muted":{"type":"color","value":"#6E5460"},"c-accent":{"type":"color","value":"#A6215C"},"c-accent-deep":{"type":"color","value":"#7E1745"},"c-accent-soft":{"type":"color","value":"#F7DDE8"},"c-border":{"type":"color","value":"#EEDDE4"},"c-rule":{"type":"color","value":"#C9A9B7"}},"children":[{"type":"frame","id":"f1","name":"概念对比科普长图","x":0,"y":0,"width":1080,"height":3060,"fill":"$c-bg","layout":"vertical","gap":0,"clip":true,"children":[{"type":"frame","id":"f6","name":"01 页头","width":"fill_container","height":"fit_content","fill":"$c-band","layout":"vertical","gap":26,"padding":[76,80,68,80],"alignItems":"start","children":[{"type":"frame","id":"f2","name":"胶囊","width":"fit_content","height":"fit_content","cornerRadius":999,"fill":"$c-accent","layout":"horizontal","padding":[10,22],"justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"科普 · 一图讲清","id":"t3","name":"胶囊文字","fill":"$c-surface","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"}]},{"type":"text","content":"降噪耳机\n降的到底是什么","id":"t4","name":"主标题","width":"fill_container","fill":"$c-surface","fontFamily":"Noto Sans SC","fontSize":76,"lineHeight":1.2,"letterSpacing":-1.4,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"两个常被混着说的词，其实是两套完全不同的做法。","id":"t5","name":"副标题","width":"fill_container","fill":"$c-band-muted","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f10","name":"02 结论","width":"fill_container","height":"fit_content","layout":"vertical","gap":0,"padding":[64,80,0,80],"alignItems":"start","children":[{"type":"frame","id":"f9","name":"结论面板","width":"fill_container","height":"fit_content","cornerRadius":24,"fill":"$c-accent-soft","layout":"vertical","gap":16,"padding":[40,36],"alignItems":"start","children":[{"type":"text","content":"它降的是低频、连续、稳定的噪声。","id":"t7","name":"结论","width":"fill_container","fill":"$c-accent-deep","fontFamily":"Noto Sans SC","fontSize":44,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"所以在地铁和飞机上最管用，在开放办公室里最不管用 —— 人说话是高频突发声，它基本抵消不掉。","id":"t8","name":"结论支撑","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f28","name":"03 定义","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"padding":[68,80,0,80],"alignItems":"start","children":[{"type":"frame","id":"f14","name":"区块头","width":"fill_container","height":"fit_content","layout":"vertical","gap":16,"alignItems":"start","children":[{"type":"rectangle","id":"r11","name":"强调短线","width":72,"height":8,"cornerRadius":999,"fill":"$c-accent"},{"type":"text","content":"先分清是哪两个东西","id":"t12","name":"区块标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":46,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"一句话说清各自的做法，剩下的差异都是从这一句推出来的。","id":"t13","name":"区块说明","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f27","name":"定义组","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"alignItems":"start","children":[{"type":"frame","id":"f20","name":"定义卡","width":"fill_container","height":"fit_content","cornerRadius":22,"fill":"$c-accent-deep","layout":"vertical","gap":14,"padding":[32,34],"alignItems":"start","children":[{"type":"frame","id":"f18","name":"定义卡头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"center","children":[{"type":"icon","library":"lucide","icon":"waves","id":"i15","name":"图标","width":40,"height":40,"fill":"$c-surface"},{"type":"text","content":"主动降噪","id":"t16","name":"概念名","fill":"$c-surface","fontFamily":"Noto Sans SC","fontSize":40,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"},{"type":"text","content":"ANC","id":"t17","name":"西文名","fill":"$c-accent-soft","fontFamily":"Inter","fontSize":24,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"}]},{"type":"text","content":"麦克风先录下环境噪声，喇叭再放一段反相声波把它抵消掉。","id":"t19","name":"原理","width":"fill_container","fill":"$c-accent-soft","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f26","name":"定义卡","width":"fill_container","height":"fit_content","cornerRadius":22,"fill":"$c-surface","stroke":"$c-border","strokeWidth":2,"layout":"vertical","gap":14,"padding":[32,34],"alignItems":"start","children":[{"type":"frame","id":"f24","name":"定义卡头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"center","children":[{"type":"icon","library":"lucide","icon":"shield","id":"i21","name":"图标","width":40,"height":40,"fill":"$c-ink"},{"type":"text","content":"被动隔音","id":"t22","name":"概念名","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":40,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"},{"type":"text","content":"Passive","id":"t23","name":"西文名","fill":"$c-muted","fontFamily":"Inter","fontSize":24,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"}]},{"type":"text","content":"靠耳罩和耳塞的材料把声音挡在外面，不通电也一直在起作用。","id":"t25","name":"原理","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]},{"type":"frame","id":"f59","name":"04 维度","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"padding":[68,80,0,80],"alignItems":"start","children":[{"type":"frame","id":"f58","name":"区块头","width":"fill_container","height":"fit_content","layout":"vertical","gap":16,"alignItems":"start","children":[{"type":"rectangle","id":"r55","name":"强调短线","width":72,"height":8,"cornerRadius":999,"fill":"$c-accent"},{"type":"text","content":"三个维度，一行一句","id":"t56","name":"区块标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":46,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"左边是主动降噪，右边是被动隔音。每格只放一句能验证的话。","id":"t57","name":"区块说明","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f54","name":"维度表","width":"fill_container","height":"fit_content","cornerRadius":24,"fill":"$c-surface","stroke":"$c-border","strokeWidth":2,"layout":"vertical","gap":22,"padding":[34,34],"alignItems":"start","children":[{"type":"frame","id":"f32","name":"表头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":26,"alignItems":"center","children":[{"type":"text","content":"主动降噪","id":"t29","name":"A 名","width":399,"fill":"$c-accent-deep","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"rectangle","id":"r30","name":"表头竖线占位","width":2,"height":2},{"type":"text","content":"被动隔音","id":"t31","name":"B 名","width":399,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"rectangle","id":"r33","name":"表头下线","width":"fill_container","height":2,"fill":"$c-rule"},{"type":"frame","id":"f40","name":"维度块","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"alignItems":"start","children":[{"type":"text","content":"擅长哪种噪声","id":"t38","name":"维度名","width":"fill_container","fill":"$c-accent-deep","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"frame","id":"f37","name":"维度两栏","width":"fill_container","height":"fit_content","layout":"horizontal","gap":26,"children":[{"type":"text","content":"低频连续：引擎、空调、地铁","id":"t34","name":"A 侧","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"},{"type":"rectangle","id":"r35","name":"竖分隔","width":2,"height":"fit_content","fill":"$c-rule"},{"type":"text","content":"高频突发：键盘、餐具、人声","id":"t36","name":"B 侧","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"}]},{"type":"rectangle","id":"r39","name":"维度分割线","width":"fill_container","height":2,"fill":"$c-border"}]},{"type":"frame","id":"f47","name":"维度块","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"alignItems":"start","children":[{"type":"text","content":"代价是什么","id":"t45","name":"维度名","width":"fill_container","fill":"$c-accent-deep","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"frame","id":"f44","name":"维度两栏","width":"fill_container","height":"fit_content","layout":"horizontal","gap":26,"children":[{"type":"text","content":"要电、有轻微底噪，一部分人戴着会耳压不适。","id":"t41","name":"A 侧","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"},{"type":"rectangle","id":"r42","name":"竖分隔","width":2,"height":"fit_content","fill":"$c-rule"},{"type":"text","content":"要压耳，戴久了会闷热夹头，夏天尤其明显。","id":"t43","name":"B 侧","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"}]},{"type":"rectangle","id":"r46","name":"维度分割线","width":"fill_container","height":2,"fill":"$c-border"}]},{"type":"frame","id":"f53","name":"维度块","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"alignItems":"start","children":[{"type":"text","content":"怎么当场验证","id":"t52","name":"维度名","width":"fill_container","fill":"$c-accent-deep","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"frame","id":"f51","name":"维度两栏","width":"fill_container","height":"fit_content","layout":"horizontal","gap":26,"children":[{"type":"text","content":"按一次开关，轰鸣明显变小。","id":"t48","name":"A 侧","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"},{"type":"rectangle","id":"r49","name":"竖分隔","width":2,"height":"fit_content","fill":"$c-rule"},{"type":"text","content":"先别开电源，戴上安静下来的那部分就是隔音。","id":"t50","name":"B 侧","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"}]}]}]}]},{"type":"frame","id":"f75","name":"05 选择","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"padding":[68,80,68,80],"alignItems":"start","children":[{"type":"frame","id":"f74","name":"区块头","width":"fill_container","height":"fit_content","layout":"vertical","gap":16,"alignItems":"start","children":[{"type":"rectangle","id":"r71","name":"强调短线","width":72,"height":8,"cornerRadius":999,"fill":"$c-accent"},{"type":"text","content":"那你该买哪个","id":"t72","name":"区块标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":46,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"按自己一天里待得最久的那个场景选，不按参数表选。","id":"t73","name":"区块说明","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f70","name":"判据面板","width":"fill_container","height":"fit_content","cornerRadius":22,"fill":"$c-accent-soft","layout":"vertical","gap":24,"padding":[36,34],"alignItems":"start","children":[{"type":"frame","id":"f64","name":"判据项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"corner-down-right","id":"i60","name":"箭头","width":28,"height":28,"fill":"$c-accent-deep"},{"type":"frame","id":"f63","name":"判据文案","width":"fill_container","height":"fit_content","layout":"vertical","gap":8,"alignItems":"start","children":[{"type":"text","content":"通勤一小时以上、常坐地铁和飞机","id":"t61","name":"场景","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"优先看主动降噪，这是它的主场。","id":"t62","name":"动作","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f69","name":"判据项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"corner-down-right","id":"i65","name":"箭头","width":28,"height":28,"fill":"$c-accent-deep"},{"type":"frame","id":"f68","name":"判据文案","width":"fill_container","height":"fit_content","layout":"vertical","gap":8,"alignItems":"start","children":[{"type":"text","content":"在开放办公室里想挡人声","id":"t66","name":"场景","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"先换耳塞尺寸，把耳道封住比开降噪管用。","id":"t67","name":"动作","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]}]},{"type":"frame","id":"f80","name":"06 页脚","width":"fill_container","height":"fit_content","fill":"$c-band","layout":"vertical","gap":12,"padding":[44,80],"alignItems":"start","children":[{"type":"text","content":"以消费级头戴与入耳耳机的常见实现为准，职业听力防护另有标准。","id":"t76","name":"口径","width":"fill_container","fill":"$c-band-muted","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.6,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"frame","id":"f79","name":"署名行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"center","children":[{"type":"text","content":"@ 你的账号名","id":"t77","name":"账号名","fill":"$c-surface","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"},{"type":"text","content":"每周一张讲清一个概念","id":"t78","name":"更新说明","fill":"$c-band-muted","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"}]}]}]}]}