      }
    },
    "input-hover": {
      "template": "<Input placeholder=\"{attr:input-text}\"{class} />",
      "imports": {
        "Input": "antd"
      }
    },
    "input-focus": {
      "template": "<Input placeholder=\"{attr:input-text}\"{class} />",
      "imports": {
        "Input": "antd"
      }
    },
    "input-invalid": {
      "template": "<Input placeholder=\"{attr:input-text}\" status=\"error\"{class} />",
