{"version":"2.20","variables":{"c-xuan":{"type":"color","value":"#F3F0E9"},"c-xuan-deep":{"type":"color","value":"#E5E1D7"},"c-case":{"type":"color","value":"#1E1813"},"c-ink":{"type":"color","value":"#2A241F"},"c-ink-soft":{"type":"color","value":"#5F5A55"},"c-ink-faint":{"type":"color","value":"#807A76"},"c-xuan-on":{"type":"color","value":"#F0ECE7"},"c-xuan-dim":{"type":"color","value":"#B4B0AA"},"c-jie":{"type":"color","value":"#D0CBC5"},"c-cinnabar":{"type":"color","value":"#AA4331"},"c-cinnabar-wash":{"type":"color","value":"#F9D7CE"}},"children":[{"type":"frame","id":"f1","name":"01 封面 · 函套","x":0,"y":0,"width":1920,"height":1080,"fill":"$c-case","layout":"none","clip":true,"children":[{"type":"frame","id":"f3","name":"主标","x":120,"y":430,"width":1680,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"汉字排版\n在屏幕上的四次退让","id":"t2","name":"主标题","width":"fill_container","fill":"$c-xuan-on","fontFamily":"Noto Sans SC","fontSize":96,"lineHeight":1.08,"letterSpacing":-1.92,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"rectangle","id":"r4","name":"朱砂短线","x":120,"y":685,"width":96,"height":2,"fill":"$c-cinnabar"},{"type":"frame","id":"f6","name":"副标","x":120,"y":725,"width":1680,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"写给编辑与界面设计者的一份版面评议","id":"t5","name":"副标题","width":"fill_container","fill":"$c-xuan-dim","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f9","name":"落款","x":120,"y":880,"width":1680,"height":"fit_content","layout":"horizontal","gap":32,"alignItems":"center","children":[{"type":"text","content":"版面组 · 内部评议","id":"t7","name":"落款 · 单位","fill":"$c-xuan-dim","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"},{"type":"text","content":"2026.08.09","id":"t8","name":"落款 · 日期","fill":"$c-xuan-dim","fontFamily":"Inter","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"}]},{"type":"path","geometry":"M0 0 L20 0 L10.0 9 Z","id":"p10","name":"鱼尾 · 上","x":950,"y":996,"width":20,"height":9,"fill":"$c-cinnabar","viewBox":[0,0,20,9]},{"type":"path","geometry":"M10.0 0 L20 9 L0 9 Z","id":"p11","name":"鱼尾 · 下","x":950,"y":1009,"width":20,"height":9,"fill":"$c-cinnabar","viewBox":[0,0,20,9]},{"type":"text","content":"1 / 7","id":"t12","name":"页码","x":860,"y":1026,"width":200,"fill":"$c-xuan-dim","fontFamily":"Inter","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textAlign":"center","textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f13","name":"02 篇目 · 函套","x":2040,"y":0,"width":1920,"height":1080,"fill":"$c-case","layout":"none","clip":true,"children":[{"type":"frame","id":"f15","name":"眉题","x":120,"y":144,"width":1680,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"篇目","id":"t14","name":"眉题","width":"fill_container","fill":"$c-xuan-dim","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]},{"type":"frame","id":"f35","name":"篇目列表","x":120,"y":264,"width":1680,"height":"fit_content","layout":"vertical","gap":0,"alignItems":"start","children":[{"type":"frame","id":"f18","name":"篇目 01","width":"fill_container","height":"fit_content","layout":"horizontal","gap":32,"padding":[36,0],"alignItems":"center","children":[{"type":"text","content":"01","id":"t16","name":"序号","width":96,"fill":"$c-xuan-dim","fontFamily":"Inter","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"版心：先给一页定出可以落墨的地方","id":"t17","name":"篇名","width":"fill_container","fill":"$c-xuan-on","fontFamily":"Noto Sans SC","fontSize":40,"lineHeight":1.35,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"rectangle","id":"r19","name":"界行 · 条间","width":"fill_container","height":1,"fill":"$c-jie"},{"type":"frame","id":"f22","name":"篇目 02","width":"fill_container","height":"fit_content","layout":"horizontal","gap":32,"padding":[36,0],"alignItems":"center","children":[{"type":"text","content":"02","id":"t20","name":"序号","width":96,"fill":"$c-xuan-dim","fontFamily":"Inter","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"界行：分栏是为了缩短行，不是分盒子","id":"t21","name":"篇名","width":"fill_container","fill":"$c-xuan-on","fontFamily":"Noto Sans SC","fontSize":40,"lineHeight":1.35,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"rectangle","id":"r23","name":"界行 · 条间","width":"fill_container","height":1,"fill":"$c-jie"},{"type":"frame","id":"f26","name":"篇目 03","width":"fill_container","height":"fit_content","layout":"horizontal","gap":32,"padding":[36,0],"alignItems":"center","children":[{"type":"text","content":"03","id":"t24","name":"序号","width":96,"fill":"$c-xuan-dim","fontFamily":"Inter","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"行长：三十个字是一道生理线","id":"t25","name":"篇名","width":"fill_container","fill":"$c-xuan-on","fontFamily":"Noto Sans SC","fontSize":40,"lineHeight":1.35,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"rectangle","id":"r27","name":"界行 · 条间","width":"fill_container","height":1,"fill":"$c-jie"},{"type":"frame","id":"f30","name":"篇目 04","width":"fill_container","height":"fit_content","layout":"horizontal","gap":32,"padding":[36,0],"alignItems":"center","children":[{"type":"text","content":"04","id":"t28","name":"序号","width":96,"fill":"$c-xuan-dim","fontFamily":"Inter","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"标点：断行处最见功夫","id":"t29","name":"篇名","width":"fill_container","fill":"$c-xuan-on","fontFamily":"Noto Sans SC","fontSize":40,"lineHeight":1.35,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"rectangle","id":"r31","name":"界行 · 条间","width":"fill_container","height":1,"fill":"$c-jie"},{"type":"frame","id":"f34","name":"篇目 05","width":"fill_container","height":"fit_content","layout":"horizontal","gap":32,"padding":[36,0],"alignItems":"center","children":[{"type":"text","content":"05","id":"t32","name":"序号","width":96,"fill":"$c-xuan-dim","fontFamily":"Inter","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"收束：把四次退让逐项收回","id":"t33","name":"篇名","width":"fill_container","fill":"$c-xuan-on","fontFamily":"Noto Sans SC","fontSize":40,"lineHeight":1.35,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]}]},{"type":"path","geometry":"M0 0 L20 0 L10.0 9 Z","id":"p36","name":"鱼尾 · 上","x":950,"y":996,"width":20,"height":9,"fill":"$c-cinnabar","viewBox":[0,0,20,9]},{"type":"path","geometry":"M10.0 0 L20 9 L0 9 Z","id":"p37","name":"鱼尾 · 下","x":950,"y":1009,"width":20,"height":9,"fill":"$c-cinnabar","viewBox":[0,0,20,9]},{"type":"text","content":"2 / 7","id":"t38","name":"页码","x":860,"y":1026,"width":200,"fill":"$c-xuan-dim","fontFamily":"Inter","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textAlign":"center","textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f39","name":"03 论述 · 版心","x":4080,"y":0,"width":1920,"height":1080,"fill":"$c-xuan","layout":"none","clip":true,"children":[{"type":"frame","id":"f41","name":"天头批注","x":120,"y":56,"width":1680,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"版心先于版式；边界不定，谈不上呼吸","id":"t40","name":"批注","width":"fill_container","fill":"$c-ink-faint","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f43","name":"页标题","x":120,"y":144,"width":1680,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"版心不是边距，是一页里可以落墨的那块地","id":"t42","name":"标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":56,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"frame","id":"f45","name":"正文","x":120,"y":264,"width":960,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"屏幕上的版面把版心简化成了四边等距的内边距，\n于是每一页都从同一个位置开始，也在同一处结束。\n古籍的做法相反：天头留给批注，地脚留给页码，\n两者从来不等高，页面因此有了上下方向。\n这一档把天头定为 144、地脚定为 108，\n多出来的那一截，是给投影时被人头遮住的下沿的。","id":"t44","name":"正文","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"rectangle","id":"r46","name":"界行 · 横","x":120,"y":648,"width":960,"height":1,"fill":"$c-jie"},{"type":"frame","id":"f56","name":"三条做法","x":120,"y":672,"width":960,"height":"fit_content","layout":"vertical","gap":0,"alignItems":"start","children":[{"type":"frame","id":"f49","name":"做法 1","width":"fill_container","height":"fit_content","layout":"horizontal","gap":24,"padding":[14,0],"alignItems":"center","children":[{"type":"text","content":"01","id":"t47","name":"序号","width":56,"fill":"$c-ink-faint","fontFamily":"Inter","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"天头留给批注，地脚留给页码与鱼尾","id":"t48","name":"做法","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f52","name":"做法 2","width":"fill_container","height":"fit_content","layout":"horizontal","gap":24,"padding":[14,0],"alignItems":"center","children":[{"type":"text","content":"02","id":"t50","name":"序号","width":56,"fill":"$c-ink-faint","fontFamily":"Inter","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"正文块收窄到三十字，宁可分栏也不放宽","id":"t51","name":"做法","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f55","name":"做法 3","width":"fill_container","height":"fit_content","layout":"horizontal","gap":24,"padding":[14,0],"alignItems":"center","children":[{"type":"text","content":"03","id":"t53","name":"序号","width":56,"fill":"$c-ink-faint","fontFamily":"Inter","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"界行的长度由版面定，与文字多少无关","id":"t54","name":"做法","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f58","name":"旁注","x":1200,"y":264,"width":600,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"版心之外的留白不是废纸。\n天头承批注，地脚承页码，\n两者各有职务在身，\n所以不必、也不该等高。","id":"t57","name":"旁注","width":"fill_container","fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"rectangle","id":"r59","name":"界行","x":1140,"y":264,"width":1,"height":708,"fill":"$c-jie"},{"type":"path","geometry":"M0 0 L20 0 L10.0 9 Z","id":"p60","name":"鱼尾 · 上","x":950,"y":996,"width":20,"height":9,"fill":"$c-cinnabar","viewBox":[0,0,20,9]},{"type":"path","geometry":"M10.0 0 L20 9 L0 9 Z","id":"p61","name":"鱼尾 · 下","x":950,"y":1009,"width":20,"height":9,"fill":"$c-cinnabar","viewBox":[0,0,20,9]},{"type":"text","content":"3 / 7","id":"t62","name":"页码","x":860,"y":1026,"width":200,"fill":"$c-ink-faint","fontFamily":"Inter","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textAlign":"center","textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f63","name":"04 双栏对读","x":0,"y":1440,"width":1920,"height":1080,"fill":"$c-xuan","layout":"none","clip":true,"children":[{"type":"frame","id":"f65","name":"页标题","x":120,"y":144,"width":1680,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"分栏是为了把行缩短，不是把内容装进两个盒子","id":"t64","name":"标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":56,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"frame","id":"f69","name":"左栏 · 其说","x":120,"y":264,"width":808,"height":"fit_content","layout":"vertical","gap":32,"alignItems":"start","children":[{"type":"text","content":"其说","id":"t66","name":"栏题","width":"fill_container","fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":40,"lineHeight":1.35,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"通行的做法是给每一栏加一个\n圆角卡片，再用底色把两边分开。\n分是分开了，读者读到的却是\n两张卡片，而不是一篇文章的\n两个部分。","id":"t67","name":"左栏正文","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"卡片还有一个副作用：它必须有内边距，\n于是同一块版心里，能排的字更少，\n行却没有因此变短。","id":"t68","name":"左栏续","width":"fill_container","fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f75","name":"右栏 · 我见","x":992,"y":264,"width":808,"height":"fit_content","layout":"vertical","gap":32,"alignItems":"start","children":[{"type":"text","content":"我见","id":"t72","name":"栏题","width":"fill_container","fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":40,"lineHeight":1.35,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"frame","id":"f71","name":"首句","width":"fill_container","height":"fit_content","fill":"$c-cinnabar-wash","layout":"vertical","gap":24,"padding":[24,24],"alignItems":"start","children":[{"type":"text","content":"界行只标记分栏，不圈占内容。","id":"t70","name":"首句","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]},{"type":"text","content":"线画在版面上，卡片扣在内容上。\n界行贯穿整个版心，不随文字长短\n伸缩；它分的是版面，不是归属。","id":"t73","name":"右栏正文","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"把分栏交给线之后，栏宽就能完全由\n行长决定：三十字一行，多出来的宽度\n留给留白，而不是留给边框。","id":"t74","name":"右栏续","width":"fill_container","fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"rectangle","id":"r76","name":"界行","x":960,"y":264,"width":1,"height":708,"fill":"$c-jie"},{"type":"path","geometry":"M0 0 L20 0 L10.0 9 Z","id":"p77","name":"鱼尾 · 上","x":950,"y":996,"width":20,"height":9,"fill":"$c-cinnabar","viewBox":[0,0,20,9]},{"type":"path","geometry":"M10.0 0 L20 9 L0 9 Z","id":"p78","name":"鱼尾 · 下","x":950,"y":1009,"width":20,"height":9,"fill":"$c-cinnabar","viewBox":[0,0,20,9]},{"type":"text","content":"4 / 7","id":"t79","name":"页码","x":860,"y":1026,"width":200,"fill":"$c-ink-faint","fontFamily":"Inter","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textAlign":"center","textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f80","name":"05 引文","x":2040,"y":1440,"width":1920,"height":1080,"fill":"$c-xuan","layout":"none","clip":true,"children":[{"type":"frame","id":"f82","name":"天头批注","x":120,"y":56,"width":1680,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"回行的距离，是版面替眼睛付的成本","id":"t81","name":"批注","width":"fill_container","fill":"$c-ink-faint","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f84","name":"页标题","x":120,"y":144,"width":1680,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"一行超过三十个汉字，眼睛就会在回行时丢位置","id":"t83","name":"标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":56,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"frame","id":"f86","name":"引文块","x":420,"y":372,"width":1080,"height":"fit_content","fill":"$c-xuan-deep","layout":"vertical","gap":24,"padding":[64,64],"alignItems":"start","children":[{"type":"text","content":"行的长度决定读者每次回行要走多远。\n走得太远，眼睛会落到上一行或下一行，\n于是要重读；重读不是理解慢，是版面失职。","id":"t85","name":"引文","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":36,"lineHeight":1.8,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f88","name":"出处","x":420,"y":732,"width":1080,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"——《版面与阅读》第二章 · 行长与回行","id":"t87","name":"出处","width":"fill_container","fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"rectangle","id":"r89","name":"界行","x":360,"y":264,"width":1,"height":708,"fill":"$c-jie"},{"type":"rectangle","id":"r90","name":"界行","x":1560,"y":264,"width":1,"height":708,"fill":"$c-jie"},{"type":"path","geometry":"M0 0 L20 0 L10.0 9 Z","id":"p91","name":"鱼尾 · 上","x":950,"y":996,"width":20,"height":9,"fill":"$c-cinnabar","viewBox":[0,0,20,9]},{"type":"path","geometry":"M10.0 0 L20 9 L0 9 Z","id":"p92","name":"鱼尾 · 下","x":950,"y":1009,"width":20,"height":9,"fill":"$c-cinnabar","viewBox":[0,0,20,9]},{"type":"text","content":"5 / 7","id":"t93","name":"页码","x":860,"y":1026,"width":200,"fill":"$c-ink-faint","fontFamily":"Inter","fontSize":24,"lineHeight":1.2,"letterSpacing":0,"textAlign":"center","textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f94","name":"06 表列","x":4080,"y":1440,"width":1920,"height":1080,"fill":"$c-xuan","layout":"none","clip":true,"children":[{"type":"frame","id":"f96","name":"天头批注","x":120,"y":56,"width":1680,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"避头尾在引擎里缺席，只能由文案补上","id":"t95","name":"批注","width":"fill_container","fill":"$c-ink-faint","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f98","name":"页标题","x":120,"y":144,"width":1680,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"断行处最见功夫，而排版引擎并不替我们避头尾","id":"t97","name":"标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":56,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"frame","id":"f134","name":"表格","x":120,"y":264,"width":1680,"height":"fit_content","layout":"vertical","gap":0,"alignItems":"start","children":[{"type":"frame","id":"f103","name":"表头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":24,"padding":[20,16],"alignItems":"start","children":[{"type":"text","content":"现象","id":"t99","name":"表头 · 格","width":280,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"当前引擎行为","id":"t100","name":"表头 · 格","width":388,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"后果","id":"t101","name":"表头 · 格","width":376,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","co