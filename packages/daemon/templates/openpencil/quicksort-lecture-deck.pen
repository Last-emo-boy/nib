,"width":260,"fill":"#55635A","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"O(n log n)","id":"n355","name":"cell-quick","width":"fill_container","fill":"#17211C","fontFamily":"Inter","fontSize":28,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"O(n log n)","id":"n356","name":"cell-merge","width":"fill_container","fill":"#17211C","fontFamily":"Inter","fontSize":28,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"n357","name":"table-row-最坏时间","width":"fill_container","height":"fit_content","stroke":"#D9D2C2","strokeWidth":{"bottom":2},"layout":"horizontal","gap":40,"padding":[24,32],"alignItems":"center","children":[{"type":"text","content":"最坏时间","id":"n358","name":"row-label","width":260,"fill":"#55635A","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"O(n²)，基准每次都取到极值","id":"n359","name":"cell-quick","width":"fill_container","fill":"#17211C","fontFamily":"Inter","fontSize":28,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"O(n log n)，与输入分布无关","id":"n360","name":"cell-merge","width":"fill_container","fill":"#17211C","fontFamily":"Inter","fontSize":28,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"n361","name":"table-row-额外空间","width":"fill_container","height":"fit_content","stroke":"#D9D2C2","strokeWidth":{"bottom":2},"layout":"horizontal","gap":40,"padding":[24,32],"alignItems":"center","children":[{"type":"text","content":"额外空间","id":"n362","name":"row-label","width":260,"fill":"#55635A","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"O(log n)，只占递归栈","id":"n363","name":"cell-quick","width":"fill_container","fill":"#17211C","fontFamily":"Inter","fontSize":28,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"O(n)，需要等长的辅助数组","id":"n364","name":"cell-merge","width":"fill_container","fill":"#17211C","fontFamily":"Inter","fontSize":28,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"n365","name":"table-row-稳定性","width":"fill_container","height":"fit_content","stroke":"#D9D2C2","strokeWidth":{"bottom":2},"layout":"horizontal","gap":40,"padding":[24,32],"alignItems":"center","children":[{"type":"text","content":"稳定性","id":"n366","name":"row-label","width":260,"fill":"#55635A","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"不稳定，交换会打乱相等元素","id":"n367","name":"cell-quick","width":"fill_container","fill":"#17211C","fontFamily":"Inter","fontSize":28,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"稳定，合并时优先取左半边","id":"n368","name":"cell-merge","width":"fill_container","fill":"#17211C","fontFamily":"Inter","fontSize":28,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"n369","name":"table-row-实际表现","width":"fill_container","height":"fit_content","stroke":"#D9D2C2","strokeWidth":{"bottom":2},"layout":"horizontal","gap":40,"padding":[24,32],"alignItems":"center","children":[{"type":"text","content":"实际表现","id":"n370","name":"row-label","width":260,"fill":"#55635A","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"常数小、缓存友好，内排序首选","id":"n371","name":"cell-quick","width":"fill_container","fill":"#17211C","fontFamily":"Inter","fontSize":28,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"性能平稳，但常数偏大","id":"n372","name":"cell-merge","width":"fill_container","fill":"#17211C","fontFamily":"Inter","fontSize":28,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":