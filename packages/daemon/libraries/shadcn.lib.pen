  "children": [
    {
      "type": "frame",
      "id": "board-buttons",
      "name": "Buttons",
      "layout": "vertical",
      "gap": 32,
      "padding": 48,
      "fill": "$background",
      "children": [
        {
          "type": "text",
          "content": "Buttons",
          "fontFamily": "$font-sans",
          "fontSize": 24,
          "fill": "$foreground",
          "lineHeight": 1.2,
          "fontWeight": "600",
          "id": "board-buttons-1"
        },
        {
          "type": "frame",
          "layout": "vertical",
          "gap": 12,
          "children": [
            {
              "type": "text",
              "content": "Variants",
              "fontFamily": "$font-sans",
              "fontSize": 13,
              "fill": "$muted-foreground",
              "lineHeight": 1.43,
              "id": "board-buttons-3"
            },
            {
              "type": "frame",
              "layout": "horizontal",
              "gap": 16,
              "alignItems": "center",
              "children": [
                {
                  "type": "frame",
                  "layout": "horizontal",
                  "height": 36,
                  "padding": [
                    0,
                    16
                  ],
                  "gap": 8,
                  "alignItems": "center",
                  "justifyContent": "center",
                  "cornerRadius": "$radius-md",
                  "fill": "$primary",
                  "effect": {
                    "type": "shadow",
                    "offset": {
                      "x": 0,
                      "y": 1
                    },
                    "blur": 2,
                    "color": "#0000000D"
                  },
                  "children": [
                    {
                      "type": "text",
                      "content": "Button",
                      "id": "button-label",
                      "fontFamily": "$font-sans",
                      "fontSize": 14,
                      "fontWeight": "500",
                      "lineHeight": 1.43,
                      "fill": "$primary-foreground"
                    }
                  ],
                  "id": "button",
                  "name": "Button / Default",
                  "reusable": true
                },
                {
                  "type": "frame",
                  "layout": "horizontal",
                  "height": 36,
                  "padding": [
                    0,
                    16
                  ],
                  "gap": 8,
                  "alignItems": "center",
                  "justifyContent": "center",
                  "cornerRadius": "$radius-md",
                  "fill": "$secondary",
                  "effect": {
                    "type": "shadow",
                    "offset": {
                      "x": 0,
                      "y": 1
                    },
                    "blur": 2,
                    "color": "#0000000D"
                  },
                  "children": [
                    {
                      "type": "text",
                      "content": "Button",
