{"version":"2.20","variables":{"c-bg":{"type":"color","value":"#F4F5FA"},"c-surface":{"type":"color","value":"#FFFFFF"},"c-ink":{"type":"color","value":"#14183A"},"c-muted":{"type":"color","value":"#63698C"},"c-accent":{"type":"color","value":"#3B4CCA"},"c-accent-soft":{"type":"color","value":"#E5E8FB"},"c-border":{"type":"color","value":"#DEE1F0"}},"children":[{"type":"frame","id":"f22","name":"01 封面","x":0,"y":0,"width":1080,"height":1440,"fill":"$c-bg","layout":"vertical","gap":0,"padding":[88,72],"justifyContent":"space_between","alignItems":"start","clip":true,"children":[{"type":"frame","id":"f3","name":"封面头部","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"alignItems":"start","children":[{"type":"frame","id":"f1","name":"徽章 · 知识拆解","width":"fit_content","height":"fit_content","cornerRadius":999,"fill":"$c-accent-soft","layout":"horizontal","gap":0,"padding":[12,24],"justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"知识拆解","id":"t2","name":"徽章文字","fill":"$c-accent","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"}]}]},{"type":"frame","id":"f7","name":"封面主标题区","width":"fill_container","height":"fit_content","layout":"vertical","gap":36,"alignItems":"start","children":[{"type":"text","content":"把一篇长文，\n拆成五张图","id":"t4","name":"封面标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":88,"lineHeight":1.25,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"rectangle","id":"r5","name":"强调短线","width":132,"height":12,"cornerRadius":6,"fill":"$c-accent"},{"type":"text","content":"写得再好，没人读完也是白写。\n这套模板帮你把长文变成能划完的轮播。","id":"t6","name":"封面副标题","width":"fill_container","fill":"$c-muted","fontFamily":"Inter","fontSize":32,"lineHeight":1.6,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f18","name":"本期目录","width":"fill_container","height":"fit_content","layout":"vertical","gap":22,"alignItems":"start","children":[{"type":"text","content":"本期三个论点","id":"t8","name":"目录标签","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"},{"type":"frame","id":"f10","name":"目录 1","width":"fill_container","height":"fit_content","layout":"horizontal","gap":24,"alignItems":"center","children":[{"type":"text","content":"01","id":"t9","name":"目录序号","fill":"$c-accent","fontFamily":"Inter","fontSize":30,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"},{"type":"text","content":"先有结论，再有论据","id":"t11","name":"目录标题","width":"fill_container","fill":"$c-ink","fontFamily":"Inter","fontSize":32,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]},{"type":"frame","id":"f13","name":"目录 2","width":"fill_container","height":"fit_content","layout":"horizontal","gap":24,"alignItems":"center","children":[{"type":"text","content":"02","id":"t12","name":"目录序号","fill":"$c-accent","fontFamily":"Inter","fontSize":30,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"},{"type":"text","content":"一页只讲一个论点","id":"t14","name":"目录标题","width":"fill_container","fill":"$c-ink","fontFamily":"Inter","fontSize":32,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]},{"type":"frame","id":"f16","name":"目录 3","width":"fill_container","height":"fit_content","layout":"horizontal","gap":24,"alignItems":"center","children":[{"type":"text","content":"03","id":"t15","name":"目录序号","fill":"$c-accent","fontFamily":"Inter","fontSize":30,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"},{"type":"text","content":"留白比字号更重要","id":"t17","name":"目录标题","width":"fill_container","fill":"$c-ink","fontFamily":"Inter","fontSize":32,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]}]},{"type":"frame","id":"f19","name":"页脚","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"justifyContent":"space_between","alignItems":"center","children":[{"type":"text","content":"@ 你的账号名","id":"t20","name":"页脚品牌","fill":"$c-muted","fontFamily":"Inter","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"},{"type":"text","content":"01 / 05","id":"t21","name":"页码","fill":"$c-muted","fontFamily":"Inter","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"}]}]},{"type":"frame","id":"f33","name":"02 论点 1","x":1200,"y":0,"width":1080,"height":1440,"fill":"$c-bg","layout":"vertical","gap":0,"padding":[88,72],"justifyContent":"space_between","alignItems":"start","clip":true,"children":[{"type":"frame","id":"f27","name":"02 内容","width":"fill_container","height":"fit_content","layout":"vertical","gap":28,"alignItems":"start","children":[{"type":"text","content":"01","id":"t23","name":"装饰序号","fill":"$c-accent-soft","fontFamily":"Inter","fontSize":220,"lineHeight":1,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"},{"type":"rectangle","id":"r24","name":"强调短线","width":96,"height":12,"cornerRadius":6,"fill":"$c-accent"},{"type":"text","content":"先有结论，再有论据","id":"t25","name":"论点标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":72,"lineHeight":1.25,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"读者划到你这一页，只会给你一眼的时间。把结论放进标题，把论据留给正文，不要让人读完三行才知道你想说什么。你以为在铺垫，读者以为你没重点。","id":"t26","name":"论点阐述","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":34,"lineHeight":1.8,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f28","name":"金句卡","width":"fill_container","height":"fit_content","cornerRadius":16,"fill":"$c-surface","stroke":"$c-accent","strokeWidth":{"left":6},"layout":"vertical","gap":0,"padding":[32,36],"alignItems":"start","children":[{"type":"text","content":"标题写结论，正文写理由。","id":"t29","name":"金句","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":34,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"frame","id":"f30","name":"页脚","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"justifyContent":"space_between","alignItems":"center","children":[{"type":"text","content":"@ 你的账号名","id":"t31","name":"页脚品牌","fill":"$c-muted","fontFamily":"Inter","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"},{"type":"text","content":"02 / 05","id":"t32","name":"页码","fill":"$c-muted","fontFamily":"Inter","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"}]}]},{"type":"frame","id":"f44","name":"03 论点 2","x":2400,"y":0,"width":1080,"height":1440,"fill":"$c-bg","layout":"vertical","gap":0,"padding":[88,72],"justifyContent":"space_between","alignItems":"start","clip":true,"children":[{"type":"frame","id":"f38","name":"03 内容","width":"fill_container","height":"fit_content","layout":"vertical","gap":28,"alignItems":"start","children":[{"type":"text","content":"02","id":"t34","name":"装饰序号","fill":"$c-accent-soft","fontFamily":"Inter","fontSize":220,"lineHeight":1,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"},{"type":"rectangle","id":"r35","name":"强调短线","width":96,"height":12,"cornerRadius":6,"fill":"$c-accent"},{"type":"text","content":"一页只讲一个论点","id":"t36","name":"论点标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":72,"lineHeight":1.25,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"轮播的优势是节奏，不是容量。一页塞两个论点，\n读者一个都记不住；拆成两页，两个都记得住。\n多拆一页的成本几乎为零，真正贵的是读者的耐心。","id":"t37","name":"论点阐述","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":34,"lineHeight":1.8,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f39","name":"金句卡","width":"fill_container","height":"fit_content","cornerRadius":16,"fill":"$c-surface","stroke":"$c-accent","strokeWidth":{"left":6},"layout":"vertical","gap":0,"padding":[32,36],"alignItems":"start","children":[{"type":"text","content":"讲不完，就拆下一页。","id":"t40","name":"金句","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":34,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"frame","id":"f41","name":"页脚","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"justifyContent":"space_between","alignItems":"center","children":[{"type":"text","content":"@ 你的账号名","id":"t42","name":"页脚品牌","fill":"$c-muted","fontFamily":"Inter","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"},{"type":"text","content":"03 / 05","id":"t43","name":"页码","fill":"$c-muted","fontFamily":"Inter","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"}]}]},{"type":"frame","id":"f55","name":"04 论点 3","x":0,"y":1800,"width":1080,"height":1440,"fill":"$c-bg","layout":"vertical","gap":0,"padding":[88,72],"justifyContent":"space_between","alignItems":"start","clip":true,"children":[{"type":"frame","id":"f49","name":"04 内容","width":"fill_container","height":"fit_content","layout":"vertical","gap":28,"alignItems":"start","children":[{"type":"text","content":"03","id":"t45","name":"装饰序号","fill":"$c-accent-soft","fontFamily":"Inter","fontSize":220,"lineHeight":1,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"},{"type":"rectangle","id":"r46","name":"强调短线","width":96,"height":12,"cornerRadius":6,"fill":"$c-accent"},{"type":"text","content":"留白比字号更重要","id":"t47","name":"论点标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":72,"lineHeight":1.25,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"想让一句话被看见，办法不是把它放大，\n而是把它周围清空。留白足够时，\n30px 的字也比挤成一堆的 60px 更醒目。","id":"t48","name":"论点阐述","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":34,"lineHeight":1.8,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f50","name":"金句卡","width":"fill_container","height":"fit_content","cornerRadius":16,"fill":"$c-surface","stroke":"$c-accent","strokeWidth":{"left":6},"layout":"vertical","gap":0,"padding":[32,36],"alignItems":"start","children":[{"type":"text","content":"想突出，先清空周围。","id":"t51","name":"金句","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":34,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"frame","id":"f52","name":"页脚","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"justifyContent":"space_between","alignItems":"center","children":[{"type":"text","content":"@ 你的账号名","id":"t53","name":"页脚品牌","fill":"$c-muted","fontFamily":"Inter","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"},{"type":"text","content":"04 / 05","id":"t54","name":"页码","fill":"$c-muted","fontFamily":"Inter","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"}]}]},{"type":"frame","id":"f86","name":"05 总结","x":1200,"y":1800,"width":1080,"height":1440,"fill":"$c-bg","layout":"vertical","gap":0,"padding":[88,72],"justifyContent":"space_between","alignItems":"start","clip":true,"children":[{"type":"frame","id":"f59","name":"总结头部","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"alignItems":"start","children":[{"type":"frame","id":"f56","name":"徽章 · 总结","width":"fit_content","height":"fit_content","cornerRadius":999,"fill":"$c-accent-soft","layout":"horizontal","gap":0,"padding":[12,24],"justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"总结","id":"t57","name":"徽章文字","fill":"$c-accent","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"}]},{"type":"text","content":"三句话，\n记住这一篇。","id":"t58","name":"总结标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":76,"lineHeight":1.25,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"frame","id":"f78","name":"回顾列表","width":"fill_container","height":"fit_content","layout":"vertical","gap":20,"alignItems":"start","children":[{"type":"frame","id":"f65","name":"回顾卡 1","width":"fill_container","height":"fit_content","cornerRadius":16,"fill":"$c-surface","layout":"horizontal","gap":24,"padding":[28,32],"alignItems":"start","children":[{"type":"frame","id":"f60","name":"回顾序号 1","width":60,"height":60,"cornerRadius":30,"fill":"$c-accent-soft","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"1","id":"t61","name":"序号","fill":"$c-accent","fontFamily":"Inter","fontSize":30,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"}]},{"type":"frame","id":"f64","name":"回顾文案","width":"fill_container","height":"fit_content","layout":"vertical","gap":8,"alignItems":"start","children":[{"type":"text","content":"结论前置","id":"t62","name":"回顾标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":34,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"标题就是观点，别让人猜。","id":"t63","name":"回顾说明","width":"fill_container","fill":"$c-muted","fontFamily":"Inter","fontSize":26,"lineHeight":1.6,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f71","name":"回顾卡 2","width":"fill_container","height":"fit_content","cornerRadius":16,"fill":"$c-surface","layout":"horizontal","gap":24,"padding":[28,32],"alignItems":"start","children":[{"type":"frame","id":"f66","name":"回顾序号 2","width":60,"height":60,"cornerRadius":30,"fill":"$c-accent-soft","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"2","id":"t67","na