{"version":"2.20","variables":{"c-bg":{"type":"color","value":"#F1F0EE"},"c-card":{"type":"color","value":"#FFFFFF"},"c-panel":{"type":"color","value":"#E5E4E2"},"c-line":{"type":"color","value":"#D8D7D5"},"c-ink":{"type":"color","value":"#121210"},"c-muted":{"type":"color","value":"#535250"},"c-faint":{"type":"color","value":"#8D8C89"},"c-inv-muted":{"type":"color","value":"#A5A4A2"}},"children":[{"type":"frame","id":"f1","name":"避坑清单长图","x":0,"y":0,"width":1080,"height":3226,"fill":"$c-bg","layout":"vertical","gap":0,"clip":true,"children":[{"type":"frame","id":"f6","name":"01 页头","width":"fill_container","height":"fit_content","fill":"$c-ink","layout":"vertical","gap":26,"padding":[76,80,68,80],"alignItems":"start","children":[{"type":"frame","id":"f2","name":"标签","width":"fit_content","height":"fit_content","cornerRadius":999,"fill":"$c-card","layout":"horizontal","padding":[10,22],"justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"避坑清单 · 做图篇","id":"t3","name":"标签文字","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"}]},{"type":"text","content":"做图最常踩的\n六个坑","id":"t4","name":"主标题","width":"fill_container","fill":"$c-card","fontFamily":"Noto Sans SC","fontSize":76,"lineHeight":1.2,"letterSpacing":-1.4,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"按踩的人数从多到少排，每条都给一句能照着改的话。","id":"t5","name":"副标题","width":"fill_container","fill":"$c-inv-muted","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f66","name":"02 排行","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"padding":[64,80,0,80],"alignItems":"start","children":[{"type":"frame","id":"f64","name":"区块头","width":"fill_container","height":"fit_content","layout":"vertical","gap":16,"alignItems":"start","children":[{"type":"rectangle","id":"r61","name":"强调短线","width":72,"height":8,"fill":"$c-ink"},{"type":"text","content":"从最常踩的那个说起","id":"t62","name":"区块标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":46,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"前三条是重灾区，单这三条就能解决大半问题。","id":"t63","name":"区块说明","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f65","name":"排行列表","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"alignItems":"start","children":[{"type":"frame","id":"f15","name":"坑","width":"fill_container","height":"fit_content","fill":"$c-ink","layout":"vertical","gap":18,"padding":[32,32],"alignItems":"start","children":[{"type":"frame","id":"f9","name":"坑头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"center","children":[{"type":"text","content":"01","id":"t7","name":"排名","width":104,"fill":"$c-faint","fontFamily":"Inter","fontSize":56,"lineHeight":1,"letterSpacing":-2,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"一页想讲完所有事","id":"t8","name":"坑标题","width":"fill_container","fill":"$c-card","fontFamily":"Noto Sans SC","fontSize":38,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"text","content":"把三段话塞进一张图，字缩到 20px，手机上谁都不会读。","id":"t13","name":"错在哪","width":"fill_container","fill":"$c-inv-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"rectangle","id":"r14","name":"改法上线","width":"fill_container","height":2,"fill":"$c-faint"},{"type":"frame","id":"f12","name":"改法","width":"fill_container","height":"fit_content","layout":"horizontal","gap":14,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"arrow-right","id":"i10","name":"箭头","width":26,"height":26,"fill":"$c-card"},{"type":"text","content":"一页只讲一个点，讲不完就加一页。","id":"t11","name":"改法文字","width":"fill_container","fill":"$c-card","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]}]},{"type":"frame","id":"f24","name":"坑","width":"fill_container","height":"fit_content","fill":"$c-ink","layout":"vertical","gap":18,"padding":[32,32],"alignItems":"start","children":[{"type":"frame","id":"f18","name":"坑头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"center","children":[{"type":"text","content":"02","id":"t16","name":"排名","width":104,"fill":"$c-faint","fontFamily":"Inter","fontSize":56,"lineHeight":1,"letterSpacing":-2,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"标题写成了说明书","id":"t17","name":"坑标题","width":"fill_container","fill":"$c-card","fontFamily":"Noto Sans SC","fontSize":38,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"text","content":"「关于如何提升时间管理效率的方法」——没人会为它停下。","id":"t22","name":"错在哪","width":"fill_container","fill":"$c-inv-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"rectangle","id":"r23","name":"改法上线","width":"fill_container","height":2,"fill":"$c-faint"},{"type":"frame","id":"f21","name":"改法","width":"fill_container","height":"fit_content","layout":"horizontal","gap":14,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"arrow-right","id":"i19","name":"箭头","width":26,"height":26,"fill":"$c-card"},{"type":"text","content":"先写结论那句话，再删到十个字以内。","id":"t20","name":"改法文字","width":"fill_container","fill":"$c-card","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]}]},{"type":"frame","id":"f33","name":"坑","width":"fill_container","height":"fit_content","fill":"$c-ink","layout":"vertical","gap":18,"padding":[32,32],"alignItems":"start","children":[{"type":"frame","id":"f27","name":"坑头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"center","children":[{"type":"text","content":"03","id":"t25","name":"排名","width":104,"fill":"$c-faint","fontFamily":"Inter","fontSize":56,"lineHeight":1,"letterSpacing":-2,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"颜色一次上五个","id":"t26","name":"坑标题","width":"fill_container","fill":"$c-card","fontFamily":"Noto Sans SC","fontSize":38,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"text","content":"每个模块一个颜色，看起来热闹，实际上等于一个都没强调。","id":"t31","name":"错在哪","width":"fill_container","fill":"$c-inv-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"rectangle","id":"r32","name":"改法上线","width":"fill_container","height":2,"fill":"$c-faint"},{"type":"frame","id":"f30","name":"改法","width":"fill_container","height":"fit_content","layout":"horizontal","gap":14,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"arrow-right","id":"i28","name":"箭头","width":26,"height":26,"fill":"$c-card"},{"type":"text","content":"一个强调色，只给最重要的那一处。","id":"t29","name":"改法文字","width":"fill_container","fill":"$c-card","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]}]},{"type":"frame","id":"f42","name":"坑","width":"fill_container","height":"fit_content","fill":"$c-card","stroke":"$c-line","strokeWidth":2,"layout":"vertical","gap":18,"padding":[32,32],"alignItems":"start","children":[{"type":"frame","id":"f36","name":"坑头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"center","children":[{"type":"text","content":"04","id":"t34","name":"排名","width":104,"fill":"$c-faint","fontFamily":"Inter","fontSize":56,"lineHeight":1,"letterSpacing":-2,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"正文和背景对比不够","id":"t35","name":"坑标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":38,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"text","content":"浅灰字压在浅灰底上，设计稿里好看，发出去在阳光下看不见。","id":"t40","name":"错在哪","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"rectangle","id":"r41","name":"改法上线","width":"fill_container","height":2,"fill":"$c-line"},{"type":"frame","id":"f39","name":"改法","width":"fill_container","height":"fit_content","layout":"horizontal","gap":14,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"arrow-right","id":"i37","name":"箭头","width":26,"height":26,"fill":"$c-ink"},{"type":"text","content":"正文对比度至少 4.5:1，先量再发。","id":"t38","name":"改法文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]}]},{"type":"frame","id":"f51","name":"坑","width":"fill_container","height":"fit_content","fill":"$c-card","stroke":"$c-line","strokeWidth":2,"layout":"vertical","gap":18,"padding":[32,32],"alignItems":"start","children":[{"type":"frame","id":"f45","name":"坑头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"center","children":[{"type":"text","content":"05","id":"t43","name":"排名","width":104,"fill":"$c-faint","fontFamily":"Inter","fontSize":56,"lineHeight":1,"letterSpacing":-2,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"装饰压在文字上","id":"t44","name":"坑标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":38,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"text","content":"光效、纹理、大图铺满整页，标题只好往上叠，读起来费劲。","id":"t49","name":"错在哪","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"rectangle","id":"r50","name":"改法上线","width":"fill_container","height":2,"fill":"$c-line"},{"type":"frame","id":"f48","name":"改法","width":"fill_container","height":"fit_content","layout":"horizontal","gap":14,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"arrow-right","id":"i46","name":"箭头","width":26,"height":26,"fill":"$c-ink"},{"type":"text","content":"给标题留一块干净的高对比区，装饰退到它外面。","id":"t47","name":"改法文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]}]},{"type":"frame","id":"f60","name":"坑","width":"fill_container","height":"fit_content","fill":"$c-card","stroke":"$c-line","strokeWidth":2,"layout":"vertical","gap":18,"padding":[32,32],"alignItems":"start","children":[{"type":"frame","id":"f54","name":"坑头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"center","children":[{"type":"text","content":"06","id":"t52","name":"排名","width":104,"fill":"$c-faint","fontFamily":"Inter","fontSize":56,"lineHeight":1,"letterSpacing":-2,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"每页都换一套版式","id":"t53","name":"坑标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":38,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"text","content":"六页像六个模板拼起来的，读者每翻一页都要重新找重点在哪。","id":"t58","name":"错在哪","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"rectangle","id":"r59","name":"改法上线","width":"fill_container","height":2,"fill":"$c-line"},{"type":"frame","id":"f57","name":"改法","width":"fill_container","height":"fit_content","layout":"horizontal","gap":14,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"arrow-right","id":"i55","name":"箭头","width":26,"height":26,"fill":"$c-ink"},{"type":"text","content":"边距、字体、页码位置锁死，只让主视觉变。","id":"t56","name":"改法文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]}]}]}]},{"type":"frame","id":"f88","name":"03 自检","width":"fill_container","height":"fit_content","layout":"vertical","gap":28,"padding":[64,80,72,80],"alignItems":"start","children":[{"type":"frame","id":"f87","name":"区块头","width":"fill_container","height":"fit_content","layout":"vertical","gap":16,"alignItems":"start","children":[{"type":"rectangle","id":"r84","name":"强调短线","width":72,"height":8,"fill":"$c-ink"},{"type":"text","content":"发之前跑一遍","id":"t85","name":"区块标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":46,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"四行，一分钟。过不了就别急着发。","id":"t86","name":"区块说明","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f83","name":"自检面板","width":"fill_container","height":"fit_content","fill":"$c-panel","layout":"vertical","gap":20,"padding":[36,34],"alignItems":"start","children":[{"type":"frame","id":"f70","name":"自检项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":18,"alignItems":"start","children":[{"type":"frame","id":"f67","name":"方框","width":40,"height":40,"fill":"$c-ink","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"icon","library":"lucide","icon":"check","id":"i68","name":"勾","width":24,"height":24,"fill":"$c-card"}]},{"type":"text","content":"标题十个字以内，且是结论不是主题","id":"t69","name":"自检文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]},{"type":"frame","id":"f74","name":"自检项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":18,"alignItems":"start","children":[{"type":"frame","id":"f71","name":"方框","width":40,"height":40,"fill":"$c-ink","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"icon","library":"lucide","icon":"check","id":"i72","name":"勾","width":24,"height":24,"fill":"$c-card"}]},{"type":"text","content":"每页正文不超过四行","id":"t73","name":"自检文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]},{"type":"frame","id":"f78","name":"自检项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":18,"alignItems":"start","children":[{"type":"frame","id":"f75","name":"方框","width":40,"height":40,"fill":"$c-ink","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"icon","library":"lucide","icon":"check","id":"i76","name":"勾","width":24,"height":24,"fill":"$c-card"}]},{"type":"text","content":"强调色只出现在一处","id":"t77","name":"自检文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]},{"type":"frame","id":"f82","name":"自检项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":18,"alignItems":"start","children":[{"type":"frame","id":"f79","name":"方框","width":40,"height":40,"fill":"$c-ink","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"icon","library":"lucide","icon":"check","id":"i80","name":"勾","width":24,"height":24,"fill":"$c-card"}]},{"type":"text","content":"手机上退后一臂距离仍能读清正文","id":"t81","name":"自检文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]}]}]},{"type":"frame","id":"f93","name":"04 页脚","width":"fill_container","height":"fit_content","fill":"$c-ink","layout":"vertical","gap":12,"padding":[44,80],"alignItems":"start","children":[{"type":"text","content":"第七个坑是「觉得自己不会踩前六个」。","id":"t89","name":"结语","width":"fill_container","fill":"$c-card","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"frame","id":"f92","name":"署名行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"center","children":[{"type":"text","content":"@ 你的账号名","id":"t90","name":"账号名","fill":"$c-card","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"},{"type":"text","content":"每周一张能照着改的图","id":"t91","name":"更新说明","fill":"$c-inv-muted","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"}]}]}]}]}