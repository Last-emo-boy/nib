{"version":"2.20","variables":{"c-linen":{"type":"color","value":"#F3EEE4"},"c-band":{"type":"color","value":"#EFE9DE"},"c-deep":{"type":"color","value":"#E6DFD3"},"c-ink":{"type":"color","value":"#201C19"},"c-ink-soft":{"type":"color","value":"#56524E"},"c-ink-faint":{"type":"color","value":"#746F6B"},"c-rule":{"type":"color","value":"#C0BDB8"},"c-thread":{"type":"color","value":"#864737"}},"children":[{"type":"frame","id":"f27","name":"01 文件首页","x":0,"y":0,"width":1920,"height":1080,"fill":"$c-linen","layout":"none","clip":true,"children":[{"type":"frame","id":"f15","name":"01 文件首页 · 正文","width":1920,"height":1080,"layout":"vertical","gap":40,"padding":[96,120,96,0],"justifyContent":"space_between","children":[{"type":"frame","id":"f21","name":"正文块","width":"fill_container","height":"fit_content","layout":"vertical","gap":0,"padding":[0,0,0,216],"children":[{"type":"frame","id":"f20","name":"页眉","width":"fill_container","height":"fit_content","layout":"horizontal","gap":48,"justifyContent":"space_between","alignItems":"start","children":[{"type":"text","content":"OPS-2026-041","id":"t16","name":"文档代号","fill":"$c-ink-faint","fontFamily":"Inter","fontSize":26,"lineHeight":1.5,"letterSpacing":2,"textGrowth":"auto","fontWeight":"500"},{"type":"frame","id":"f19","name":"骑缝页标","width":"fit_content","height":"fit_content","layout":"vertical","gap":10,"alignItems":"end","children":[{"type":"text","content":"p. 1 / 8","id":"t17","name":"页标","fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"},{"type":"rectangle","id":"r18","name":"细线","width":48,"height":1,"fill":"$c-rule"}]}]}]},{"type":"frame","id":"f14","name":"正文块","width":"fill_container","height":"fit_content","layout":"vertical","gap":44,"padding":[0,0,0,216],"children":[{"type":"rectangle","id":"r2","name":"细线","width":1584,"height":2,"fill":"$c-thread"},{"type":"text","content":"把门店巡检从抽查\n改为全量记录","id":"t1","name":"文档标题","width":1584,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":76,"lineHeight":1.1,"letterSpacing":-1.52,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"巡检是我们唯一能在事故发生前拿到的一手信息。\n过去两年它以人工抽查的方式运行，覆盖到的门店不足四成，\n上报的问题在纸质表单与工作群之间流转，闭环时长无从统计。\n本备忘给出三个方案的取舍、所需投入，\n以及三项需要在本月内批复的事项。","id":"t3","name":"摘要","width":900,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.8,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"frame","id":"f13","name":"签发信息","width":"fill_container","height":"fit_content","layout":"vertical","gap":12,"children":[{"type":"frame","id":"f6","name":"元信息行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"start","children":[{"type":"text","content":"收件人","id":"t4","name":"元信息标签","fill":"$c-ink-faint","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"},{"type":"text","content":"运营中心 · 门店运营组 · 信息技术部","id":"t5","name":"元信息值","fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"}]},{"type":"frame","id":"f9","name":"元信息行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"start","children":[{"type":"text","content":"签发日期","id":"t7","name":"元信息标签","fill":"$c-ink-faint","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"},{"type":"text","content":"2026-08-09","id":"t8","name":"元信息值","fill":"$c-ink-soft","fontFamily":"Inter","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"}]},{"type":"frame","id":"f12","name":"元信息行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"start","children":[{"type":"text","content":"密级","id":"t10","name":"元信息标签","fill":"$c-ink-faint","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"},{"type":"text","content":"内部 · 限项目组","id":"t11","name":"元信息值","fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"}]}]}]}]},{"type":"frame","id":"f22","name":"01 文件首页 · 装订","width":1920,"height":1080,"layout":"none","children":[{"type":"rectangle","id":"r23","name":"装订孔","x":115,"y":264,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r24","name":"装订孔","x":115,"y":534,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r25","name":"装订孔","x":115,"y":804,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r26","name":"装订线","x":120,"y":0,"width":2,"height":1080,"fill":"$c-thread"}]}]},{"type":"frame","id":"f57","name":"02 背景","x":2040,"y":0,"width":1920,"height":1080,"fill":"$c-linen","layout":"none","clip":true,"children":[{"type":"frame","id":"f45","name":"02 背景 · 正文","width":1920,"height":1080,"layout":"vertical","gap":48,"padding":[96,120,96,0],"justifyContent":"start","children":[{"type":"frame","id":"f51","name":"正文块","width":"fill_container","height":"fit_content","layout":"vertical","gap":0,"padding":[0,0,0,216],"children":[{"type":"frame","id":"f50","name":"页眉","width":"fill_container","height":"fit_content","layout":"horizontal","gap":48,"justifyContent":"space_between","alignItems":"start","children":[{"type":"text","content":"OPS-2026-041","id":"t46","name":"文档代号","fill":"$c-ink-faint","fontFamily":"Inter","fontSize":26,"lineHeight":1.5,"letterSpacing":2,"textGrowth":"auto","fontWeight":"500"},{"type":"frame","id":"f49","name":"骑缝页标","width":"fit_content","height":"fit_content","layout":"vertical","gap":10,"alignItems":"end","children":[{"type":"text","content":"p. 2 / 8","id":"t47","name":"页标","fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"},{"type":"rectangle","id":"r48","name":"细线","width":48,"height":1,"fill":"$c-rule"}]}]}]},{"type":"frame","id":"f44","name":"节","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"children":[{"type":"frame","id":"f42","name":"节标题行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§1","id":"t40","name":"节号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.115,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"text","content":"背景与问题","id":"t41","name":"节标题","width":1584,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":44,"lineHeight":1.25,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"frame","id":"f43","name":"节内容","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"children":[{"type":"frame","id":"f31","name":"编号段","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§1.1","id":"t29","name":"段号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.077,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f30","name":"段落","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"text","content":"人工抽查按片区轮换，每家门店平均 47 天才被巡到一次。\n到店的检查项由巡检员当场手写，回办公室再录入系统，\n两个环节之间平均隔了 1.8 天，照片与表单常常对不上号。\n抽查本身没有错，错的是把抽查的结果当成了全量的结论。","id":"t28","name":"正文","width":900,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.8,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f35","name":"编号段","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§1.2","id":"t33","name":"段号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.077,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f34","name":"段落","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"text","content":"问题上报走工作群，群里同时还有排班、报修与日常通知。\n信息一旦被后面的消息顶下去，就等于没有发生过。\n上季度共 1342 条上报，能追溯到闭环记录的只有 611 条。","id":"t32","name":"正文","width":900,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.8,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f39","name":"编号段","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§1.3","id":"t37","name":"段号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.077,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f38","name":"段落","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"text","content":"各区域对同一个检查项的判定尺度并不一致：\n华东把冷链温度超标记为一般问题，华南记为严重问题，\n汇总到集团时，两者被加在了同一个数字里。","id":"t36","name":"正文","width":900,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.8,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]}]}]},{"type":"frame","id":"f52","name":"02 背景 · 装订","width":1920,"height":1080,"layout":"none","children":[{"type":"rectangle","id":"r53","name":"装订孔","x":115,"y":264,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r54","name":"装订孔","x":115,"y":534,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r55","name":"装订孔","x":115,"y":804,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r56","name":"装订线","x":120,"y":0,"width":2,"height":1080,"fill":"$c-thread"}]}]