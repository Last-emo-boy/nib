{"version":"2.20","variables":{"c-bg":{"type":"color","value":"#FBF7F2"},"c-surface":{"type":"color","value":"#FFFFFF"},"c-band":{"type":"color","value":"#1C1A17"},"c-band-muted":{"type":"color","value":"#ADA396"},"c-ink":{"type":"color","value":"#221F1B"},"c-muted":{"type":"color","value":"#6B6459"},"c-accent":{"type":"color","value":"#D14D08"},"c-accent-deep":{"type":"color","value":"#A83D06"},"c-accent-soft":{"type":"color","value":"#FCE7D6"},"c-border":{"type":"color","value":"#ECE3D7"},"c-rail":{"type":"color","value":"#96876F"}},"children":[{"type":"frame","id":"f1","name":"流程步骤长图","x":0,"y":0,"width":1080,"height":3085,"fill":"$c-bg","layout":"vertical","gap":0,"clip":true,"children":[{"type":"frame","id":"f6","name":"01 页头","width":"fill_container","height":"fit_content","fill":"$c-band","layout":"vertical","gap":26,"padding":[76,80,68,80],"alignItems":"start","children":[{"type":"frame","id":"f2","name":"胶囊","width":"fit_content","height":"fit_content","cornerRadius":999,"fill":"$c-accent","layout":"horizontal","gap":10,"padding":[9,20],"justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"上手指南 · 第一次做图","id":"t3","name":"胶囊文字","fill":"$c-surface","fontFamily":"Noto Sans SC","fontSize":23,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"}]},{"type":"text","content":"五步做完\n第一张图","id":"t4","name":"主标题","width":"fill_container","fill":"$c-surface","fontFamily":"Noto Sans SC","fontSize":76,"lineHeight":1.2,"letterSpacing":-1.4,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"全程约一小时，中间可以停。每一步都能单独做完。","id":"t5","name":"副标题","width":"fill_container","fill":"$c-band-muted","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f65","name":"02 步骤","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"padding":[64,80,0,80],"alignItems":"start","children":[{"type":"frame","id