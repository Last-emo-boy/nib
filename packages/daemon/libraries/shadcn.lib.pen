                    }
                  ],
                  "id": "button-sm",
                  "name": "Button / Small",
                  "reusable": true
                },
                {
                  "type": "frame",
                  "layout": "horizontal",
                  "height": 40,
                  "padding": [
                    0,
                    24
                  ],
                  "gap": 8,
                  "alignItems": "center",
                  "justifyContent": "center",
                  "cornerRadius": "$radius-md",
                  "fill": "$primary",
                  "effect": {
                    "type": "shadow",
                    "offset": {
                      "x": 0,
                      "y": 1
                    },
                    "blur": 2,
