,"fontSize":30,"lineHeight":1.5,"letterSpacing":0,"textAlign":"center","textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f43","name":"06 词 · 久","x":4080,"y":1440,"width":1920,"height":1080,"fill":"$c-bg","layout":"vertical","gap":44,"padding":[200,200],"justifyContent":"center","alignItems":"center","clip":true,"children":[{"type":"text","content":"久","id":"t44","name":"大词","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":300,"lineHeight":1,"letterSpacing":0,"textAlign":"center","textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"一次充电，用满两天。","id":"t45","name":"注解","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.5,"letterSpacing":0,"textAlign":"center","textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f46","name":"07 引用","x":0,"y":2880,"width":1920,"height":1080,"fill":"$c-bg","layout":"vertical","gap":36,"padding":[200,200],"justifyContent":"center","alignItems":"center","clip":true,"children":[{"type":"text","content":"“","id":"t47","name":"引号","width":"fill_container","fill":"$c-accent","fontFamily":"Inter","fontSize":200,"lineHeight":0.5,"letterSpacing":0,"textAlign":"center","textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"最好的设计，\n是让人忘了它存在。","id":"t48","name":"引文","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":76,"lineHeight":1.25,"letterSpacing":-1.52,"textAlign":"center","textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"— 产品负责人 沈亦文","id":"t49","name":"出处","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.5,"letterSpacing":0,"textAlign":"center","textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f50","name":"08 数据","x":2040,"y":2880,"width":1920,"height":1080,"fill":"$c-bg","layout":"vertical","gap":36,"padding":[200,200],"justifyContent":"center","alignItems":"center","