,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"外包队伍 68%。\n同样的培训，差别在返修要不要自己扛。","id":"t194","name":"证据说明","width":900,"fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"rectangle","id":"r196","name":"横线","width":"fill_container","height":1,"fill":"$c-rule"},{"type":"frame","id":"f199","name":"证据条","width":"fill_container","height":"fit_content","layout":"vertical","gap":8,"alignItems":"start","children":[{"type":"text","content":"改约主要卡在配件不在车上","id":"t197","name":"证据标题","width":1080,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":36,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"不是人手不够。\n配件调度这一段本来就在我们自己手里。","id":"t198","name":"证据说明","width":900,"fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"rectangle","id":"r200","name":"横线","width":"fill_container","height":1,"fill":"$c-rule"},{"type":"frame","id":"f203","name":"证据条","width":"fill_container","height":"fit_content","layout":"vertical","gap":8,"alignItems":"start","children":[{"type":"text","content":"经销商并不反对我们自己装","id":"t201","name":"证据标题","width":1080,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":36,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"他们要的是卖机器那笔返点，\n安装对他们一直是成本中心。","id":"t202","name":"证据说明","width":900,"fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"rectangle","id":"r209","name":"竖线","width":1,"height":"fit_content","fill":"$c-rule"},{"type":"frame","id":"f207","name":"判断栏","width":491,"height":"fit_content","fill":"$c-paper-deep","layout":"vertical","gap":24,"padding":[32,32],"alignItems":"start","children":[{"type":"rectang