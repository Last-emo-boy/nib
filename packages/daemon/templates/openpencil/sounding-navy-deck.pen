1.4,"letterSpacing":1,"textGrowth":"auto","fontWeight":"500"}]}]}]},{"type":"frame","id":"f236","name":"07 行动","x":0,"y":2880,"width":1920,"height":1080,"fill":"$c-navy","layout":"none","clip":true,"children":[{"type":"frame","id":"f235","name":"07 行动 · 正文","width":1920,"height":1080,"layout":"vertical","gap":48,"padding":[96,120,120,120],"justifyContent":"space_between","alignItems":"start","children":[{"type":"text","content":"先把华南的安装收回来\n再谈全国","id":"t237","name":"收束句","width":1680,"fill":"$c-on-navy","fontFamily":"Noto Sans SC","fontSize":72,"lineHeight":1.12,"letterSpacing":-1.44,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"frame","id":"f238","name":"行动区","width":"fill_container","height":"fit_content","layout":"horizontal","gap":48,"alignItems":"start","children":[{"type":"frame","id":"f228","name":"行动 1","width":528,"height":"fit_content","layout":"vertical","gap":16,"alignItems":"start","children":[{"type":"text","content":"01","id":"t226","name":"行动序号","width":528,"fill":"$c-steel-lift","fontFamily":"Inter","fontSize":40,"lineHeight":1.35,"letterSpacing":1,"textGrowth":"fixed-width","fontWeight":"500"},{"type":"text","content":"九月底前接管\n华南两个仓的配件调度","id":"t227","name":"行动文案","width":528,"fill":"$c-on-navy","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]},{"type":"frame","id":"f231","name":"行动 2","width":528,"height":"fit_content","layout":"vertical","gap":16,"alignItems":"start","children":[{"type":"text","content":"02","id":"t229","name":"行动序号","width":528,"fill":"$c-steel-lift","fontFamily":"Inter","fontSize":40,"lineHeight":1.35,"letterSpacing":1,"textGrowth":"fixed-width","fontWeight":"500"},{"type":"text","content":"十月起在广深\n自招一百二十名安装师傅","id":"t230","name":"行动文案","width":528,"fill":"$c-on-navy","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.75,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]},{"type":"frame","id":"f234","name":"行动 3","width":