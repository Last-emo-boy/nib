{
  "name": "nib",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p apps/editor",
    "dev": "sh scripts/dev.sh",
    "desktop": "pnpm --filter @nib/editor build && pnpm --filter @nib/desktop exec electron .",
    "package:desktop": "pnpm --filter @nib/desktop package",
    "nib": "node packages/cli/src/main.ts",
    "package:chrome": "node apps/chrome/src/build.ts",
    "package:vscode": "cp LICENSE apps/vscode/LICENSE && cd apps/vscode && npx --yes @vscode/vsce@3 package --no-dependencies --skip-license -o ../../out/nib-vscode.vsix; rm -f LICENSE"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
