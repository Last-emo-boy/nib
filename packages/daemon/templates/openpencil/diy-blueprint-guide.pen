-line","strokeWidth":2,"layout":"vertical","gap":14,"padding":[20,20],"alignItems":"start","children":[{"type":"frame","id":"f107","name":"步骤图位","width":"fill_container","height":230,"cornerRadius":6,"fill":"$c-slot","layout":"vertical","gap":8,"justifyContent":"center","alignItems":"center","children":[{"type":"icon","library":"lucide","icon":"camera","id":"i108","name":"图位图标","width":32,"height":32,"fill":"$c-muted"},{"type":"text","content":"打磨中","id":"t109","name":"图位提示","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":23,"lineHeight":1.4,"letterSpacing":0,"textAlign":"center","textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"frame","id":"f112","name":"步骤头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":8,"alignItems":"center","children":[{"type":"text","content":"06","id":"t110","name":"步骤序号","width":54,"fill":"$c-ink","fontFamily":"Inter","fontSize":30,"lineHeight":1.2,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"打磨上油","id":"t111","name":"步骤名","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"text","content":"180 目磨平，320 目收光，再薄涂两遍油。","id":"t113","name":"步骤说明","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":23,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]}]},{"type":"frame","id":"f132","name":"04 成品","width":"fill_container","height":"fit_content","layout":"vertical","gap":26,"padding":[64,80,0,80],"alignItems":"start","children":[{"type":"frame","id":"f131","name":"区块头","width":"fill_container","height":"fit_content","layout":"vertical","gap":14,"alignItems":"start","children":[{"type":"rectangle","id":"r128","name":"强调短线","width":72,"height":8,"fill":"$c-ink"},{"type":"text","content":"做完长这样","id":"t129","name":"区块标题","width":"fill_container","fill":