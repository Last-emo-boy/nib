{"version":"2.20","variables":{"c-bg":{"type":"color","value":"#F6F3FB"},"c-surface":{"type":"color","value":"#FFFFFF"},"c-band":{"type":"color","value":"#201741"},"c-band-muted":{"type":"color","value":"#A99EC8"},"c-ink":{"type":"color","value":"#1F1730"},"c-muted":{"type":"color","value":"#625A78"},"c-accent":{"type":"color","value":"#7A3FBF"},"c-accent-deep":{"type":"color","value":"#5C2C95"},"c-accent-soft":{"type":"color","value":"#EDE4FB"},"c-border":{"type":"color","value":"#E5DCF2"},"c-rule":{"type":"color","value":"#CDBFE4"}},"children":[{"type":"frame","id":"f1","name":"问答 FAQ 长图","x":0,"y":0,"width":1080,"height":2789,"fill":"$c-bg","layout":"vertical","gap":0,"clip":true,"children":[{"type":"frame","id":"f6","name":"01 页头","width":"fill_container","height":"fit_content","fill":"$c-band","layout":"vertical","gap":26,"padding":[76,80,68,80],"alignItems":"start","children":[{"type":"frame","id":"f2","name":"胶囊","width":"fit_content","height":"fit_content","cornerRadius":999,"fill":"$c-accent","layout":"horizontal","padding":[10,22],"justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"常见问题 · 六问六答","id":"t3","name":"胶囊文字","fill":"$c-surface","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"}]},{"type":"text","content":"被问最多的\n六个问题","id":"t4","name":"主标题","width":"fill_container","fill":"$c-surface","fontFamily":"Noto Sans SC","fontSize":76,"lineHeight":1.2,"letterSpacing":-1.4,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"每条都能单独读完，挑你现在正卡住的那条看就行。","id":"t5","name":"副标题","width":"fill_container","fill":"$c-band-muted","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f72","name":"02 问答","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"padding":[68,80,0,80],"alignItems":"start","children":[{"type":"frame","id":"f7