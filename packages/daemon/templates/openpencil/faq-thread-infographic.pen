"height":"fit_content","layout":"horizontal","gap":20,"alignItems":"start","children":[{"type":"frame","id":"f11","name":"A 标","width":46,"height":46,"cornerRadius":12,"stroke":"$c-accent","strokeWidth":2,"layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"A","id":"t12","name":"标记字母","fill":"$c-accent-deep","fontFamily":"Inter","fontSize":24,"lineHeight":1,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"}]},{"type":"text","content":"先定一个与播放量无关的目标：连发十期，第十期之后再决定。","id":"t13","name":"答句","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f26","name":"问答卡","width":"fill_container","height":"fit_content","cornerRadius":22,"fill":"$c-surface","stroke":"$c-border","strokeWidth":2,"layout":"vertical","gap":22,"padding":[32,32],"alignItems":"start","children":[{"type":"frame","id":"f20","name":"问","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"start","children":[{"type":"frame","id":"f17","name":"Q 标","width":46,"height":46,"cornerRadius":12,"fill":"$c-accent","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"Q","id":"t18","name":"标记字母","fill":"$c-surface","fontFamily":"Inter","fontSize":24,"lineHeight":1,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"}]},{"type":"text","content":"多久发一次合适？","id":"t19","name":"问句","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"rectangle","id":"r25","name":"问答分割线","width":"fill_container","height":2,"fill":"$c-rule"},{"type":"frame","id":"f24","name":"答","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"start","children":[{"type":"frame","id":"f21","name":"A 标","width":46,"height":46,"cornerRadius":12,"stroke":"$c-accent","strokeWidth":2,"layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"A","id":"t22","name":"标记字母","fill":"$c-accent-deep","fontFamily":"Inter","fontSize":24,"lineHeight":1,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"}]},{"type":"text","content":"选一个你在最忙的那一周也能做到的频率。做不到的频率会让你在第五周直接停掉。","id":"t23","name":"答句","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f36","name":"问答卡","width":"fill_container","height":"fit_content","cornerRadius":22,"fill":"$c-surface","stroke":"$c-border","strokeWidth":2,"layout":"vertical","gap":22,"padding":[32,32],"alignItems":"start","children":[{"type":"frame","id":"f30","name":"问","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"start","children":[{"type":"frame","id":"f27","name":"Q 标","width":46,"height":46,"cornerRadius":12,"fill":"$c-accent","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"Q","id":"t28","name":"标记字母","fill":"$c-surface","fontFamily":"Inter","fontSize":24,"lineHeight":1,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"}]},{"type":"text","content":"要不要先攒够素材再开始？","id":"t29","name":"问句","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"rectangle","id":"r35","name":"问答分割线","width":"fill_container","height":2,"fill":"$c-rule"},{"type":"frame","id":"f34","name":"答","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"start","children":[{"type":"frame","id":"f31","name":"A 标","width":46,"height":46,"cornerRadius":12,"stroke":"$c-accent","strokeWidth":2,"layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"A","id":"t32","name":"标记字母","fill":"$c-accent-deep","fontFamily":"Inter","fontSize":24,"lineHeight":1,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"}]},{"type":"text","content":"不要。攒素材是最舒服的一种拖延，发出去之后才知道该攒什么。","id":"t33","name":"答句","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f46","name":"问答卡","width":"fill_container","height":"fit_content","cornerRadius":22,"fill":"$c-surface","stroke":"$c-border","strokeWidth":2,"layout":"vertical","gap":22,"padding":[32,32],"alignItems":"start","children":[{"type":"frame","id":"f40","name":"问","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"start","children":[{"type":"frame","id":"f37","name":"Q 标","width":46,"height":46,"cornerRadius":12,"fill":"$c-accent","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"Q","id":"t38","name":"标记字母","fill":"$c-surface","fontFamily":"Inter","fontSize":24,"lineHeight":1,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"}]},{"type":"text","content":"封面和内容哪个更重要？","id":"t39","name":"问句","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"rectangle","id":"r45","name":"问答分割线","width":"fill_container","height":2,"fill":"$c-rule"},{"type":"frame","id":"f44","name":"答","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"start","children":[{"type":"frame","id":"f41","name":"A 标","width":46,"height":46,"cornerRadius":12,"stroke":"$c-accent","strokeWidth":2,"layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"A","id":"t42","name":"标记字母","fill":"$c-accent-deep","fontFamily":"Inter","fontSize":24,"lineHeight":1,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"}]},{"type":"text","content":"封面决定点不点进来，内容决定下次还点不点。前十期先做内容。","id":"t43","name":"答句","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f56","name":"问答卡","width":"fill_container","height":"fit_content","cornerRadius":22,"fill":"$c-surface","stroke":"$c-border","strokeWidth":2,"layout":"vertical","gap":22,"padding":[32,32],"alignItems":"start","children":[{"type":"frame","id":"f50","name":"问","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"start","children":[{"type":"frame","id":"f47","name":"Q 标","width":46,"height":46,"cornerRadius":12,"fill":"$c-accent","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"Q","id":"t48","name":"标记字母","fill":"$c-surface","fontFamily":"Inter","fontSize":24,"lineHeight":1,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"}]},{"type":"text","content":"被说得不好听怎么办？","id":"t49","name":"问句","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"rectangle","id":"r55","name":"问答分割线","width":"fill_container","height":2,"fill":"$c-rule"},{"type":"frame","id":"f54","name":"答","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"start","children":[{"type":"frame","id":"f51","name":"A 标","width":46,"height":46,"cornerRadius":12,"stroke":"$c-accent","strokeWidth":2,"layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"A","id":"t52","name":"标记字母","fill":"$c-accent-deep","fontFamily":"Inter","fontSize":24,"lineHeight":1,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"}]},{"type":"text","content":"只回带具体建议的那一条，其余不回。回一条要花掉二十分钟，值不值这个时间自己算。","id":"t53","name":"答句","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f66","name":"问答卡","width":"fill_container","height":"fit_content","cornerRadius":22,"fill":"$c-surface","stroke":"$c-border","strokeWidth":2,"layout":"vertical","gap":22,"padding":[32,32],"alignItems":"start","children":[{"type":"frame","id":"f60","name":"问","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"start","children":[{"type":"frame","id":"f57","name":"Q 标","width":46,"height":46,"cornerRadius":12,"fill":"$c-accent","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"Q","id":"t58","name":"标记字母","fill":"$c-surface","fontFamily":"Inter","fontSize":24,"lineHeight":1,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"}]},{"type":"text","content":"什么时候可以开始收费？","id":"t59","name":"问句","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"rectangle","id":"r65","name":"问答分割线","width":"fill_container","height":2,"fill":"$c-rule"},{"type":"frame","id":"f64","name":"答","width":"fill_container","height":"fit_content","layout":"horizontal","gap":20,"alignItems":"start","children":[{"type":"frame","id":"f61","name":"A 标","width":46,"height":46,"cornerRadius":12,"stroke":"$c-accent","strokeWidth":2,"layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"A","id":"t62","name":"标记字母","fill":"$c-accent-deep","fontFamily":"Inter","fontSize":24,"lineHeight":1,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"}]},{"type":"text","content":"有人第二次主动来找你的时候。第一次可能是好奇，第二次才是需求。","id":"t63","name":"答句","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]}]},{"type":"frame","id":"f84","name":"03 收尾","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"padding":[68,80,68,80],"alignItems":"start","children":[{"type":"frame","id":"f83","name":"区块头","width":"fill_container","height":"fit_content","layout":"vertical","gap":16,"alignItems":"start","children":[{"type":"rectangle","id":"r80","name":"强调短线","width":72,"height":8,"cornerRadius":999,"fill":"$c-accent"},{"type":"text","content":"还有别的问题吗","id":"t81","name":"区块标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":46,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"这张图会随问题更新，被问到第三次的会被加进来。","id":"t82","name":"区块说明","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f79","name":"收尾面板","width":"fill_container","height":"fit_content","cornerRadius":22,"fill":"$c-accent-soft","layout":"vertical","gap":18,"padding":[36,34],"alignItems":"start","children":[{"type":"frame","id":"f75","name":"收尾项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"message-square","id":"i73","name":"图标","width":28,"height":28,"fill":"$c-accent-deep"},{"type":"text","content":"这六个问题占了私信的八成，其余多是这六个的变体。","id":"t74","name":"收尾文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]},{"type":"frame","id":"f78","name":"收尾项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"pen-line","id":"i76","name":"图标","width":28,"height":28,"fill":"$c-accent-deep"},{"type":"text","content":"还有没答上的，写在评论区 —— 下一张从被问得最多的那条开始。","id":"t77","name":"收尾文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]}]}]},{"type":"frame","id":"f89","name":"04 页脚","width":"fill_container","height":"fit_content","fill":"$c-band","layout":"vertical","gap":12,"padding":[44,80],"alignItems":"start","children":[{"type":"text","content":"问题取自近半年私信，同义合并后按出现次数从多到少排。","id":"t85","name":"口径","width":"fill_container","fill":"$c-band-muted","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.6,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"frame","id":"f88","name":"署名行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"center","children":[{"type":"text","content":"@ 你的账号名","id":"t86","name":"账号名","fill":"$c-surface","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"},{"type":"text","content":"每季度更新一次这张问答","id":"t87","name":"更新说明","fill":"$c-band-muted","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"}]}]}]}]}