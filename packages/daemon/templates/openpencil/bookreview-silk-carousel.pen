d":"f114","name":"主栏","width":530,"height":"fit_content","layout":"vertical","gap":20,"alignItems":"start","children":[{"type":"text","content":"原文","id":"t110","name":"栏标","fill":"$c-azurite-d","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"},{"type":"text","content":"他花了整整一章去解释为什么没有选另外一条路。读到这里才发现，前面所有铺垫都是为这一次不选做准备。","id":"t111","name":"引文","width":530,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":40,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"rectangle","id":"r112","name":"栏内分隔","width":530,"height":1,"fill":"$c-ochre"},{"type":"text","content":"作者全程没有评价它。","id":"t113","name":"引文续","width":530,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":40,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"rectangle","id":"r119","name":"栏线","width":1,"height":280,"fill":"$c-ochre"},{"type":"frame","id":"f118","name":"侧栏","width":296,"height":"fit_content","layout":"vertical","gap":18,"alignItems":"start","children":[{"type":"text","content":"我的注","id":"t115","name":"栏标","fill":"$c-malachite-d","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"},{"type":"text","content":"不评价，等于把判断整个留给读者。","id":"t116","name":"注解 1","width":296,"fill":"$c-soft","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"text","content":"这也是全书唯一的一次视角外移。","id":"t117","name":"注解 2","width":296,"fill":"$c-soft","fontFamily":"Noto Sans SC","fontSize":32,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]},{"type":"frame","id":"f129","name":"页脚","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"alignItems":"start","children":[{"type":"rectangle","id":"r127","name":"赭石分隔线","width":"fill_container","height":1,"fill":"$c-ochre"},{"type":"