      }
    },
    "button-danger-hover": {
      "template": "<Button type=\"primary\" danger{class}>{text:button-danger-label}</Button>",
      "imports": {
        "Button": "antd"
      }
    },
    "button-danger-pressed": {
      "template": "<Button type=\"primary\" danger{class}>{text:button-danger-label}</Button>",
      "imports": {
