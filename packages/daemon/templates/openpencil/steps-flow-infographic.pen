:"start","children":[{"type":"text","content":"导出前通读一遍","id":"t53","name":"步骤标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":34,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"念出声地读一遍。读不顺的句子，图上也一定看着别扭。","id":"t54","name":"步骤说明","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"frame","id":"f55","name":"胶囊","width":"fit_content","height":"fit_content","cornerRadius":999,"fill":"$c-accent-soft","layout":"horizontal","gap":10,"padding":[9,20],"justifyContent":"center","alignItems":"center","children":[{"type":"icon","library":"lucide","icon":"clock","id":"i56","name":"胶囊图标","width":23,"height":23,"fill":"$c-accent-deep"},{"type":"text","content":"5 分钟","id":"t57","name":"胶囊文字","fill":"$c-accent-deep","fontFamily":"Noto Sans SC","fontSize":23,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"}]}]}]}]}]},{"type":"frame","id":"f77","name":"03 提示","width":"fill_container","height":"fit_content","layout":"vertical","gap":28,"padding":[64,80,72,80],"alignItems":"start","children":[{"type":"frame","id":"f76","name":"区块头","width":"fill_container","height":"fit_content","layout":"vertical","gap":16,"alignItems":"start","children":[{"type":"rectangle","id":"r73","name":"强调短线","width":72,"height":8,"cornerRadius":999,"fill":"$c-accent"},{"type":"text","content":"两句实话","id":"t74","name":"区块标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":46,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"做过的人都会撞上的两件事，先说在前面。","id":"t75","name":"区块说明","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f72","name":"提示面板","width":