{"version":"2.20","variables":{"c-board":{"type":"color","value":"#1E2E27"},"c-panel":{"type":"color","value":"#26382F"},"c-card":{"type":"color","value":"#2C4139"},"c-line":{"type":"color","value":"#3D5449"},"c-chalk":{"type":"color","value":"#F0EBDF"},"c-muted":{"type":"color","value":"#A6B5AB"},"c-accent":{"type":"color","value":"#E8B14C"},"c-accent-ink":{"type":"color","value":"#2A1E04"}},"children":[{"type":"frame","id":"f1","name":"周报小课长图","x":0,"y":0,"width":1080,"height":3116,"fill":"$c-board","layout":"vertical","gap":0,"clip":true,"children":[{"type":"frame","id":"f6","name":"01 页头","width":"fill_container","height":"fit_content","fill":"$c-panel","layout":"vertical","gap":26,"padding":[80,80,70,80],"alignItems":"start","children":[{"type":"frame","id":"f2","name":"课次标签","width":"fit_content","height":"fit_content","cornerRadius":4,"fill":"$c-accent","layout":"horizontal","padding":[10,20],"justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"职场小课 · Lesson 01","id":"t3","name":"课次文字","fill":"$c-accent-ink","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"700"}]},{"type":"text","content":"周报不是流水账\n是一次汇报","id":"t4","name":"主标题","width":"fill_container","fill":"$c-chalk","fontFamily":"Noto Sans SC","fontSize":76,"lineHeight":1.2,"letterSpacing":-1.4,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"四段结构 + 一张可以直接填的骨架。这节课学完就能用在这周五。","id":"t5","name":"副标题","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f21","name":"02 痛点","width":"fill_container","height":"fit_content","layout":"vertical","gap":26,"padding":[64,80,0,80],"alignItems":"start","children":[{"type":"frame","id":"f19","name":"区块头","width":"fill_container","height":"fit_content","layout":"vertical","gap":14,"alignItems":"start","children":[{"type":"rectangle","id":"r16","name":"强调短线","width":72,"height":8,"fill":"$c-accent"},{"type":"text","content":"先说清楚它为什么难写","id":"t17","name":"区块标题","width":"fill_container","fill":"$c-chalk","fontFamily":"Noto Sans SC","fontSize":46,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"三条里只要中一条，你的周报就白写了。","id":"t18","name":"区块说明","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f20","name":"痛点列表","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"alignItems":"start","children":[{"type":"frame","id":"f9","name":"痛点项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":12,"alignItems":"start","children":[{"type":"text","content":"01","id":"t7","name":"痛点序号","width":64,"fill":"$c-accent","fontFamily":"Inter","fontSize":28,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"写成流水账：把日程表复制一遍，读的人看不出你解决了什么。","id":"t8","name":"痛点文字","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f12","name":"痛点项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":12,"alignItems":"start","children":[{"type":"text","content":"02","id":"t10","name":"痛点序号","width":64,"fill":"$c-accent","fontFamily":"Inter","fontSize":28,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"只报喜不报忧：卡住的地方藏着，等到爆雷时才第一次被看见。","id":"t11","name":"痛点文字","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f15","name":"痛点项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":12,"alignItems":"start","children":[{"type":"text","content":"03","id":"t13","name":"痛点序号","width":64,"fill":"$c-accent","fontFamily":"Inter","fontSize":28,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"没有下一步：写完这周就结束了，读的人不知道该给你什么支持。","id":"t14","name":"痛点文字","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]},{"type":"frame","id":"f59","name":"03 结构","width":"fill_container","height":"fit_content","layout":"vertical","gap":26,"padding":[64,80,0,80],"alignItems":"start","children":[{"type":"frame","id":"f57","name":"区块头","width":"fill_container","height":"fit_content","layout":"vertical","gap":14,"alignItems":"start","children":[{"type":"rectangle","id":"r54","name":"强调短线","width":72,"height":8,"fill":"$c-accent"},{"type":"text","content":"四段，按这个顺序排","id":"t55","name":"区块标题","width":"fill_container","fill":"$c-chalk","fontFamily":"Noto Sans SC","fontSize":46,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"段名可以换措辞，顺序不要换——读的人是按这个顺序找信息的。","id":"t56","name":"区块说明","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f58","name":"结构列表","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"alignItems":"start","children":[{"type":"frame","id":"f29","name":"结构段","width":"fill_container","height":"fit_content","cornerRadius":12,"fill":"$c-card","layout":"vertical","gap":14,"padding":[28,30],"alignItems":"start","children":[{"type":"frame","id":"f24","name":"段头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":8,"alignItems":"center","children":[{"type":"text","content":"01","id":"t22","name":"段序号","width":62,"fill":"$c-accent","fontFamily":"Inter","fontSize":30,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"做成了什么","id":"t23","name":"段名","width":"fill_container","fill":"$c-chalk","fontFamily":"Noto Sans SC","fontSize":34,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"text","content":"写结果，不写过程。一条一件事，动词开头。","id":"t28","name":"段要求","width":"fill_container","fill":"$c-chalk","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f27","name":"反面提示","width":"fill_container","height":"fit_content","layout":"horizontal","gap":12,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"circle-x","id":"i25","name":"反面图标","width":24,"height":24,"fill":"$c-muted"},{"type":"text","content":"别写「推进了 XX 项目」——推进不是结果。","id":"t26","name":"反面文字","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":23,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f37","name":"结构段","width":"fill_container","height":"fit_content","cornerRadius":12,"fill":"$c-card","layout":"vertical","gap":14,"padding":[28,30],"alignItems":"start","children":[{"type":"frame","id":"f32","name":"段头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":8,"alignItems":"center","children":[{"type":"text","content":"02","id":"t30","name":"段序号","width":62,"fill":"$c-accent","fontFamily":"Inter","fontSize":30,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"数据怎么样","id":"t31","name":"段名","width":"fill_container","fill":"$c-chalk","fontFamily":"Noto Sans SC","fontSize":34,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"text","content":"给一个能对比的数：跟上周比，或跟目标比。","id":"t36","name":"段要求","width":"fill_container","fill":"$c-chalk","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f35","name":"反面提示","width":"fill_container","height":"fit_content","layout":"horizontal","gap":12,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"circle-x","id":"i33","name":"反面图标","width":24,"height":24,"fill":"$c-muted"},{"type":"text","content":"别只给绝对值，没有对照的数字说明不了任何事。","id":"t34","name":"反面文字","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":23,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f45","name":"结构段","width":"fill_container","height":"fit_content","cornerRadius":12,"fill":"$c-card","layout":"vertical","gap":14,"padding":[28,30],"alignItems":"start","children":[{"type":"frame","id":"f40","name":"段头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":8,"alignItems":"center","children":[{"type":"text","content":"03","id":"t38","name":"段序号","width":62,"fill":"$c-accent","fontFamily":"Inter","fontSize":30,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"卡在哪里","id":"t39","name":"段名","width":"fill_container","fill":"$c-chalk","fontFamily":"Noto Sans SC","fontSize":34,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"text","content":"写清楚卡点 + 你需要谁做什么。","id":"t44","name":"段要求","width":"fill_container","fill":"$c-chalk","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f43","name":"反面提示","width":"fill_container","height":"fit_content","layout":"horizontal","gap":12,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"circle-x","id":"i41","name":"反面图标","width":24,"height":24,"fill":"$c-muted"},{"type":"text","content":"别写「有一些困难」——那等于没写。","id":"t42","name":"反面文字","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":23,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f53","name":"结构段","width":"fill_container","height":"fit_content","cornerRadius":12,"fill":"$c-card","layout":"vertical","gap":14,"padding":[28,30],"alignItems":"start","children":[{"type":"frame","id":"f48","name":"段头","width":"fill_container","height":"fit_content","layout":"horizontal","gap":8,"alignItems":"center","children":[{"type":"text","content":"04","id":"t46","name":"段序号","width":62,"fill":"$c-accent","fontFamily":"Inter","fontSize":30,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"下周做什么","id":"t47","name":"段名","width":"fill_container","fill":"$c-chalk","fontFamily":"Noto Sans SC","fontSize":34,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"text","content":"最多三件，按优先级排，写清交付物。","id":"t52","name":"段要求","width":"fill_container","fill":"$c-chalk","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f51","name":"反面提示","width":"fill_container","height":"fit_content","layout":"horizontal","gap":12,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"circle-x","id":"i49","name":"反面图标","width":24,"height":24,"fill":"$c-muted"},{"type":"text","content":"别列十件。列十件等于告诉别人你没排过优先级。","id":"t50","name":"反面文字","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":23,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]}]},{"type":"frame","id":"f111","name":"04 骨架","width":"fill_container","height":"fit_content","layout":"vertical","gap":26,"padding":[64,80,0,80],"alignItems":"start","children":[{"type":"frame","id":"f110","name":"区块头","width":"fill_container","height":"fit_content","layout":"vertical","gap":14,"alignIt