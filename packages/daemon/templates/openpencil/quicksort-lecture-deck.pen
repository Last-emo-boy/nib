l_container","fill":"#55635A","fontFamily":"Inter","fontSize":27,"lineHeight":1.7,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"n33","name":"objective-card-4","width":"fill_container","height":"fit_content","cornerRadius":20,"fill":"#FFFFFF","layout":"vertical","gap":18,"padding":[40,44],"justifyContent":"center","children":[{"type":"frame","id":"n34","name":"step-circle-4","width":64,"height":64,"cornerRadius":100,"fill":"#1B6B4C","layout":"horizontal","padding":[12,16],"justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"4","id":"n35","name":"step-digit","fill":"#FFFFFF","fontFamily":"Inter","fontSize":29,"lineHeight":1,"fontWeight":"700"}]},{"type":"text","content":"选对排序算法","id":"n36","name":"objective-title","fill":"#17211C","fontFamily":"Noto Sans SC","fontSize":36,"lineHeight":1.3,"fontWeight":"600"},{"type":"text","content":"在稳定性、内存与数据分布之间做出取舍","id":"n37","name":"objective-desc","width":"fill_container","fill":"#55635A","fontFamily":"Inter","fontSize":27,"lineHeight":1.7,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]}]},{"type":"frame","id":"n38","name":"03 算法思想","x":4080,"y":0,"width":1920,"height":1080,"fill":"#F2EEE2","layout":"vertical","gap":48,"padding":[120,120],"justifyContent":"start","clip":true,"children":[{"type":"frame","id":"n39","name":"page-header","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"text","content":"先分区，再递归：一次只解决一个位置","id":"n40","name":"page-title","width":"fill_container","fill":"#17211C","fontFamily":"Noto Sans SC","fontSize":64,"lineHeight":1.15,"letterSpacing":-1,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"快排不是一口气排好，而是每一轮把一个元素送到它最终该在的位置","id":"n41","name":"page-subtitle","width":"fill_container","fill":"#55635A","fontFamily":"Inter","fontSize":30,"lineHeight":1.45,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"n42","name":"idea-body","width":"fill_container","height":"fit_content","layout":"vertical","gap":40,"justifyContent":"center","children":[{"type":"frame","id":"n43","name":"step-row","width":"fill_container","height":"fit_content","layout":"horizontal","gap":32,"children":[{"type":"frame","id":"n44","name":"step-card-1","width":"fill_container","height":"fit_content","cornerRadius":20,"fill":"#FFFFFF","layout":"vertical","gap":20,"padding":[44,40],"children":[{"type":"frame","id":"n45","name":"step-circle-1","width":64,"height":64,"cornerRadius":100,"fill":"#1B6B4C","layout":"horizontal","padding":[12,16],"justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"1","id":"n46","name":"step-digit","fill":"#FFFFFF","fontFamily":"Inter","fontSize":29,"lineHeight":1,"fontWeight":"700"}]},{"type":"text","content":"选基准","id":"n47","name":"step-title","fill":"#17211C","fontFamily":"Noto Sans SC","fontSize":38,"lineHeight":1.3,"fontWeight":"600"},{"type":"text","content":"在待排区间里挑一个元素当分界线。本讲统一取区间最后一个元素。","id":"n48","name":"step-desc","width":"fill_container","fill":"#55635A","fontFamily":"Inter","fontSize":27,"lineHeight":1.7,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"n49","name":"step-card-2","width":"fill_container","height":"fit_content","cornerRadius":20,"fill":"#FFFFFF","layout":"vertical","gap":20,"padding":[44,40],"children":[{"type":"frame","id":"n50","name":"step-circle-2","width":64,"height":64,"cornerRadius":100,"fill":"#1B6B4C","layout":"horizontal","padding":[12,16],"justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"2","id":"n51","name":"step-digit","fill":"#FFFFFF","fontFamily":"Inter","fontSize":29,"lineHeight":1,"fontWeight":"700"}]},{"type":"text","content":"分区","id":"n52","name":"step-title","fill":"#17211C","fontFamily":"Noto Sans SC","fontSize":38,"lineHeight":1.3,"fontWeight":"600"},{"type":"text","content":"扫描一遍，把不大于基准的元素都甩到左边，基准最后落到分界点上。","id":"n53","name":"step-desc","width":"fill_container","fill":"#55635A","fontFamily":"Inter","fontSize":27,"lineHeight":1.7,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"n54","name":"step-card-3","width":"fill_container","height":"fit_content","cornerRadius":20,"fill":"#FFFFFF","layout":"vertical","gap":20,"padding":[44,40],"children":[{"type":"frame","id":"n55","name":"step-circle-3","width":64,"height":64,"cornerRadius":100,"fill":"#1B6B4C","layout":"horizontal","padding":[12,16],"justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"3","id":"n56","name":"step-digit","fill":"#FFFFFF","fontFamily":"Inter","fontSize":29,"lineHeight":1,"fontWeight":"700"}]},{"type":"text","content":"递归","id":"n57","name":"step-title","fill":"#17211C","fontFamily":"Noto Sans SC","fontSize":38,"lineHeight":1.3,"fontWeight":"600"},{"type":"text","content":"对基准左右两段重复同样的动作，直到区间里只剩一个元素为止。","id":"n58","name":"step-desc","width":"fill_container","fill":"#55635A","fontFamily":"Inter","fontSize":27,"lineHeight":1.7,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"n59","name":"key-takeaway","width":"fill_container","height":"fit_content","cornerRadius":20,"fill":"#D8E9DE","layout":"horizontal","gap":28,"padding":[32,40],"alignItems":"center","children":[{"type":"frame","id":"n60","name":"takeaway-pill","width":"fit_content","height":"fit_content","fill":"#1B6B4C","layout":"horizontal","padding":[8,18],"justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"记住","id":"n61","name":"takeaway-label","fill":"#FFFFFF","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.4,"fontWeight":"600"}]},{"type":"text","content":"每完成一次分区，就有一个元素永久归位 —— 这就是快排不需要额外合并步骤的原因。","id":"n62","name":"takeaway-text","width":"fill_container","fill":"#17211C","fontFamily":"Inter","fontSize":28,"lineHeight":1.5,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]},{"type":"frame","id":"n63","name":"04 分区演示 上","x":0,"y":1440,"width":1920,"height":1080,"fill":"#F2EEE2","layout":"vertical","gap"