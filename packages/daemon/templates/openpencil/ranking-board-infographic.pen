{"version":"2.20","variables":{"c-bg":{"type":"color","value":"#12100B"},"c-surface":{"type":"color","value":"#1E1B12"},"c-ink":{"type":"color","value":"#F8F4E9"},"c-muted":{"type":"color","value":"#A79C82"},"c-accent":{"type":"color","value":"#E0AB4A"},"c-accent-dim":{"type":"color","value":"#8A6F2E"},"c-accent-soft":{"type":"color","value":"#2A2415"},"c-border":{"type":"color","value":"#332E20"}},"children":[{"type":"frame","id":"f1","name":"榜单 TOP N 长图","x":0,"y":0,"width":1080,"height":3154,"fill":"$c-bg","layout":"vertical","gap":0,"clip":true,"children":[{"type":"frame","id":"f6","name":"01 页头","width":"fill_container","height":"fit_content","fill":"$c-accent","layout":"vertical","gap":26,"padding":[76,80,68,80],"alignItems":"start","children":[{"type":"frame","id":"f2","name":"胶囊","width":"fit_content","height":"fit_content","cornerRadius":999,"fill":"$c-bg","layout":"horizontal","padding":[9,20],"justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"年度榜单 · TOP 8","id":"t3","name":"胶囊文字","fill":"$c-accent","fontFamily":"Noto Sans SC","fontSize":23,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"}]},{"type":"text","content":"用满一年\n还留着的八个","id":"t4","name":"主标题","width":"fill_container","fill":"$c-bg","fontFamily":"Noto Sans SC","fontSize":76,"lineHeight":1.2,"letterSpacing":-1.4,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"评选口径写在图片最下方，可直接对着这张单子抄。","id":"t5","name":"副标题","width":"fill_container","fill":"$c-accent-soft","fontFamily":"Noto Sans SC","fontSize":28,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f36","name":"02 前三","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"padding":[68,80,0,80],"alignItems":"start","children":[{"type":"frame","id":"f34","name":"区块头","width":"fill_container","height":"fit_content","layout":"vertical","gap":16,"alignItems":"start","children":[{"type":"rectangl