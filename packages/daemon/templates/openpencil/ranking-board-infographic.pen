","id":"t75","name":"名称","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"},{"type":"text","content":"每月","id":"t76","name":"频次","fill":"$c-accent","fontFamily":"Noto Sans SC","fontSize":23,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"}]},{"type":"text","content":"想不清楚就关掉屏幕。列不出三条，说明还没想明白。","id":"t78","name":"理由","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]}]},{"type":"frame","id":"f101","name":"04 口径","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"padding":[68,80,68,80],"alignItems":"start","children":[{"type":"frame","id":"f100","name":"区块头","width":"fill_container","height":"fit_content","layout":"vertical","gap":16,"alignItems":"start","children":[{"type":"rectangle","id":"r97","name":"强调短线","width":72,"height":8,"cornerRadius":999,"fill":"$c-accent"},{"type":"text","content":"这个榜是怎么排的","id":"t98","name":"区块标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":46,"lineHeight":1.3,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"先说清楚规则，再看名次 —— 不写口径的榜单是广告。","id":"t99","name":"区块说明","width":"fill_container","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f96","name":"口径面板","width":"fill_container","height":"fit_content","cornerRadius":22,"fill":"$c-accent-soft","layout":"vertical","gap":18,"padding":[36,34],"alignItems":"start","children":[{"type":"frame","id":"f89","name":"口径项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"calendar-check","id":"i87","name":"图标","width":28,"height":28,"fill":"$c-accent"},{"type":"text","content":"连续用满 12 个月才进榜，试用期一律不算。","id":"t88","name":"口径文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]},{"type":"frame","id":"f92","name":"口径项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"list-ordered","id":"i90","name":"图标","width":28,"height":28,"fill":"$c-accent"},{"type":"text","content":"按打开次数排，不按付费金额排。","id":"t91","name":"口径文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]},{"type":"frame","id":"f95","name":"口径项","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"start","children":[{"type":"icon","library":"lucide","icon":"filter","id":"i93","name":"图标","width":28,"height":28,"fill":"$c-accent"},{"type":"text","content":"同类只留一个 —— 留下的那个是最后活下来的。","id":"t94","name":"口径文字","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":27,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]}]}]},{"type":"frame","id":"f106","name":"05 页脚","width":"fill_container","height":"fit_content","fill":"$c-accent","layout":"vertical","gap":12,"padding":[44,80],"alignItems":"start","children":[{"type":"text","content":"统计区间：2025-08 至 2026-07，按每日打开次数取中位数。","id":"t102","name":"说明","width":"fill_container","fill":"$c-accent-soft","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.6,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"},{"type":"frame","id":"f105","name":"署名行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"center","children":[{"type":"text","content":"@ 你的账号名","id":"t103","name":"账号名","fill":"$c-bg","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"},{"type":"text","content":"每年更新一次这张榜","id":"t104","name":"更新说明","fill":"$c-accent-soft","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"}]}]}]}]}