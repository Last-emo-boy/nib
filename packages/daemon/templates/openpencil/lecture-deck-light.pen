195","name":"04 例题","x":0,"y":1440,"width":1920,"height":1080,"fill":"$c-bg","layout":"none","clip":true,"children":[{"type":"frame","id":"f171","name":"04 例题 · 正文","width":1920,"height":1080,"layout":"vertical","gap":56,"padding":[120,120],"justifyContent":"start","alignItems":"start","children":[{"type":"frame","id":"f198","name":"页头","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"alignItems":"start","children":[{"type":"text","content":"按这四步走，一步都不要跳","id":"t197","name":"页标题","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":76,"lineHeight":1.12,"letterSpacing":-1.52,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"frame","id":"f199","name":"例题区","width":"fill_container","height":"fill_container","layout":"vertical","gap":0,"justifyContent":"center","alignItems":"start","children":[{"type":"frame","id":"f169","name":"知识点卡","width":"fill_container","height":"fit_content","cornerRadius":20,"fill":"$c-surface","layout":"horizontal","gap":0,"padding":[0,0],"clip":true,"children":[{"type":"rectangle","id":"r168","name":"知识点色条","width":10,"height":"fit_content","fill":"$c-accent"},{"type":"frame","id":"f167","name":"卡内容","width":"fill_container","height":"fit_content","layout":"vertical","gap":32,"padding":[40,44],"alignItems":"start","children":[{"type":"frame","id":"f141","name":"题干","width":"fill_container","height":"fit_content","cornerRadius":16,"fill":"$c-accent-soft","layout":"vertical","gap":12,"padding":[32,36],"alignItems":"start","children":[{"type":"text","content":"例题","id":"t139","name":"题干标签","fill":"$c-accent","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.3,"letterSpacing":1,"textGrowth":"auto","fontWeight":"600"},{"type":"text","content":"求函数 f(x) = x³ − 3x² + 1 的单调区间与极值。","id":"t140","name":"题干正文","width":"fill_container","fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":34,"lineHeight":1.35,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"f