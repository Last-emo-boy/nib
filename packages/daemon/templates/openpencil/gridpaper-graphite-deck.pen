idth":1920,"height":1080,"fill":"$c-paper","layout":"none","clip":true,"children":[{"type":"frame","id":"f571","name":"标签舌 · 结果 · 结论","x":88,"y":96,"width":192,"height":40,"layout":"none","children":[{"type":"text","content":"结果 · 结论","id":"t570","name":"标签舌 · 字","x":30,"y":6,"fill":"$c-paper","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.45,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"},{"type":"path","geometry":"M12 0 L192 0 L192 40 L0 40 Z","id":"p569","name":"标签舌 · 形","x":0,"y":0,"width":192,"height":40,"fill":"$c-green","viewBox":[0,0,192,40]}]},{"type":"frame","id":"f573","name":"页标题","x":112,"y":168,"width":1680,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"把灯调暗两档，可以把鸣唱提前量压回十分钟以内","id":"t572","name":"标题","width":"fill_container","fill":"$c-graphite","fontFamily":"Noto Sans SC","fontSize":60,"lineHeight":1.18,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"700"}]},{"type":"frame","id":"f585","name":"结论列表","x":112,"y":336,"width":1680,"height":"fit_content","layout":"vertical","gap":0,"alignItems":"start","children":[{"type":"frame","id":"f576","name":"结论 1","width":"fill_container","height":"fit_content","layout":"horizontal","gap":24,"padding":[26,0],"alignItems":"start","children":[{"type":"text","content":"01","id":"t574","name":"序号","width":72,"fill":"$c-faint","fontFamily":"Inter","fontSize":24,"lineHeight":1.45,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"},{"type":"text","content":"照度与鸣唱提前量之间是单调的剂量—反应关系","id":"t575","name":"结论","width":1584,"fill":"$c-graphite","fontFamily":"Noto Sans SC","fontSize":36,"lineHeight":1.35,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"500"}]},{"type":"rectangle","id":"r577","name":"条间细线","width":"fill_container","height":1,"fill":"$c-hair"},{"type":"frame","id":"f580","name":"结论 2","width":"fill_container","height":"fit_content","layout":"horizontal","gap":24,"padding":[26,0],"alignItems":"start"