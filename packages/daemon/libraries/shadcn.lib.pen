                  ],
                  "id": "button-lg",
                  "name": "Button / Large",
                  "reusable": true
                },
                {
                  "type": "frame",
                  "layout": "horizontal",
                  "width": 36,
                  "height": 36,
                  "alignItems": "center",
                  "justifyContent": "center",
                  "cornerRadius": "$radius-md",
                  "fill": "$input-background",
                  "stroke": "$border",
                  "strokeWidth": 1,
                  "effect": {
                    "type": "shadow",
                    "offset": {
                      "x": 0,
                      "y": 1
                    },
                    "blur": 2,
                    "color": "#0000000D"
                  },
                  "children": [
                    {
                      "type": "icon",
                      "library": "lucide",
                      "icon": "chevron-right",
                      "width": 16,
                      "height": 16,
                      "id": "button-icon-glyph",
                      "fill": "$foreground"
                    }
                  ],
                  "id": "button-icon",
                  "name": "Button / Icon",
                  "reusable": true
                },
                {
                  "type": "frame",
                  "layout": "horizontal",
                  "height": 36,
                  "padding": [
                    0,
                    16,
                    0,
                    12
                  ],
                  "gap": 8,
                  "alignItems": "center",
                  "cornerRadius": "$radius-md",
                  "fill": "$primary",
                  "effect": {
                    "type": "shadow",
                    "offset": {
