ontSize":24,"lineHeight":1.45,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"},{"type":"path","geometry":"M12 0 L168 0 L168 40 L0 40 Z","id":"p486","name":"标签舌 · 形","x":0,"y":0,"width":168,"height":40,"fill":"$c-amber","viewBox":[0,0,168,40]}]},{"type":"frame","id":"f491","name":"局限 2","x":688,"y":360,"width":528,"height":"fit_content","layout":"vertical","gap":20,"alignItems":"start","children":[{"type":"text","content":"只覆盖六个物种","id":"t489","name":"局限标题","width":"fill_container","fill":"$c-graphite","fontFamily":"Noto Sans SC","fontSize":36,"lineHeight":1.35,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"六个物种约占样点内个体\n的七成，剩下三成、尤其\n是夜行性种类的响应仍是\n空白。","id":"t490","name":"局限说明","width":"fill_container","fill":"$c-soft","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f494","name":"标签舌 · 局限 03","x":1240,"y":288,"width":168,"height":40,"layout":"none","children":[{"type":"text","content":"局限 03","id":"t493","name":"标签舌 · 字","x":30,"y":6,"fill":"$c-paper","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.45,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"},{"type":"path","geometry":"M12 0 L168 0 L168 40 L0 40 Z","id":"p492","name":"标签舌 · 形","x":0,"y":0,"width":168,"height":40,"fill":"$c-amber","viewBox":[0,0,168,40]}]},{"type":"frame","id":"f497","name":"局限 3","x":1264,"y":360,"width":528,"height":"fit_content","layout":"vertical","gap":20,"alignItems":"start","children":[{"type":"text","content":"照度不等于光谱","id":"t495","name":"局限标题","width":"fill_container","fill":"$c-graphite","fontFamily":"Noto Sans SC","fontSize":36,"lineHeight":1.35,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"本文只记录了照度，未区\n分光谱成分。蓝光占比可\n能才是更直接的驱动量，\n这需要另一组实验。","id":"t496","name":"局限说明","width":"fill_container","fill":"$c-soft","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f499","name":"适用范围","x":112,"y":744,"width":1680,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"这三条都不改变结论的方向，只限定它的适用范围：温带、六个物种、以照度为自变量。","id":"t498","name":"适用范围","width":"fill_container","fill":"$c-graphite","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"rectangle","id":"r500","name":"细线","x":112,"y":960,"width":1680,"height":1,"fill":"$c-hair"},{"type":"frame","id":"f502","name":"引证槽","x":112,"y":984,"width":1240,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"[4] 韦知远，2025，光生物学与物候，7(1): 33–48","id":"t501","name":"引证","width":"fill_container","fill":"$c-faint","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.45,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f504","name":"页码","x":1592,"y":984,"width":200,"height":"fit_content","layout":"vertical","gap":24,"alignItems":"start","children":[{"type":"text","content":"6 / 8","id":"t503","name":"页码","width":200,"fill":"$c-faint","fontFamily":"Inter","fontSize":24,"lineHeight":1.45,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"rectangle","id":"r505","name":"格线 · 竖","x":16,"y":0,"width":1,"height":1080,"fill":"$c-grid"},{"type":"rectangle","id":"r506","name":"格线 · 竖","x":64,"y":0,"width":1,"height":1080,"fill":"$c-grid"},{"type":"rectangle","id":"r507","name":"格线 · 竖","x":112,"y":0,"width":1,"height":1080,"fill":"$c-grid"},{"type":"rectangle","id":"r508","name":"格线 · 竖","x":160,"y":0,"width":1,"height":1080,"fill":"$c-grid"},{"type":"rectangle","id":"r509","name":"格线 · 竖","x":208,"y":0,"width":1,"height":1080,"fill":"$c-grid"},{"type":"rectangle","id":"r510","name":"格线 · 竖","x":256,"y":0,"width":1,"height":1080,"fill":"$c-grid"},{"type"