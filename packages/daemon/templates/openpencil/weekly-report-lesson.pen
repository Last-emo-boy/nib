","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"alignItems":"start","children":[{"type":"frame","id":"f120","name":"方框","width":36,"height":36,"cornerRadius":6,"fill":"$c-accent","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"icon","library":"lucide","icon":"check","id":"i121","name":"勾","width":22,"height":22,"fill":"$c-accent-ink"}]},{"type":"text","content":"先写「卡在哪」，再回头写「做成了什么」，顺序反着来更容易写。","id":"t122","name":"收尾文字","width":"fill_container","fill":"$c-chalk","fontFamily":"Noto Sans SC","fontSize":25,"lineHeight":1.7,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f128","name":"署名行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"justifyContent":"space_between","alignItems":"center","children":[{"type":"text","content":"@ 你的账号名","id":"t126","name":"账号名","fill":"$c-chalk","fontFamily":"Noto Sans SC","fontSize":25,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"600"},{"type":"text","content":"每周一节能当天用上的职场课","id":"t127","name":"更新说明","fill":"$c-muted","fontFamily":"Noto Sans SC","fontSize":23,"lineHeight":1.4,"letterSpacing":0,"textGrowth":"auto","fontWeight":"400"}]}]}]}]}