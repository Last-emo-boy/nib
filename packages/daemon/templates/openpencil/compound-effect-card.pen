{"version":"2.20","children":[{"type":"frame","id":"n1","name":"复利效应知识卡","x":0,"y":0,"width":1080,"height":1350,"fill":{"type":"gradient","gradientType":"linear","rotation":205,"colors":[{"color":"#FFF9F2","position":0},{"color":"#FDEDDA","position":0.55},{"color":"#F8DCBE","position":1}]},"layout":"vertical","gap":24,"padding":[64,64,56,64],"clip":true,"children":[{"type":"frame","id":"n2","name":"header","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"frame","id":"n3","name":"eyebrow-row","width":"fill_container","height":"fit_content","layout":"horizontal","gap":16,"justifyContent":"space_between","alignItems":"center","children":[{"type":"frame","id":"n4","name":"eyebrow-pill","width":"fit_content","height":"fit_content","cornerRadius":999,"fill":"#F7DCBB","layout":"horizontal","padding":[10,22],"alignItems":"center","children":[{"type":"text","content":"思维模型 · 01","id":"n5","name":"eyebrow-label","fill":"#A03E12","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.45,"letterSpacing":0,"textAlign":"left","fontWeight":"700"}]},{"type":"text","content":"每天 1% · 一年 37 倍","id":"n6","name":"eyebrow-stat","fill":"#C1560F","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.45,"letterSpacing":0,"textAlign":"right","fontWeight":"700"}]},{"type":"text","content":"复利效应","id":"n7","name":"card-title","width":"fill_container","fill":"#3A2415","fontFamily":"Noto Sans SC","fontSize":96,"lineHeight":1.06,"letterSpacing":-1.5,"textAlign":"left","textGrowth":"fixed-width","fontWeight":"800"},{"type":"rectangle","id":"n8","name":"title-rule","width":120,"height":8,"cornerRadius":4,"fill":"#C1560F"}]},{"type":"text","content":"复利效应是指收益本身继续产生收益：每一次微小的增长都被叠进下一轮的起点。它在短期内几乎看不见，却会在足够长的时间里，把微弱的差距放大成难以追赶的鸿沟。","id":"n9","name":"core-explanation","width":"fill_container","fill":"#5A3F2B","fontFamily":"Inter","fontSize":30,"lineHeight":1.75,"letterSpacing":0,"textAlign":"left","textGrowth":"fixed-width","fontWeight":"400"},{"type":"frame","id":"n10","name":"points-list","width":"fill_container","height":"fit_content","layout":"vertical","gap":16,"children":[{"type":"frame","id":"n11","name":"point-card-01","width":"fill_container","height":"fit_content","cornerRadius":24,"fill":"#FFFFFF","stroke":"#F2DFC7","strokeWidth":2,"layout":"horizontal","gap":24,"padding":[28,32],"alignItems":"start","children":[{"type":"frame","id":"n12","name":"point-badge-01","width":72,"height":72,"cornerRadius":36,"fill":"#C1560F","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"01","id":"n13","name":"point-num-01","fill":"#FFFFFF","fontFamily":"Inter","fontSize":30,"lineHeight":1.2,"letterSpacing":0,"textAlign":"center","fontWeight":"800"}]},{"type":"frame","id":"n14","name":"point-body-01","width":"fill_container","height":"fit_content","layout":"vertical","gap":10,"children":[{"type":"text","content":"起点微小，斜率才是关键","id":"n15","name":"point-title-01","width":"fill_container","fill":"#3A2415","fontFamily":"Noto Sans SC","fontSize":38,"lineHeight":1.35,"letterSpacing":0,"textAlign":"left","textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"早期的差距小到几乎看不见，真正拉开距离的，是每一轮能否稳住那一点点增长率。","id":"n16","name":"point-desc-01","width":"fill_container","fill":"#8A6A52","fontFamily":"Inter","fontSize":26,"lineHeight":1.75,"letterSpacing":0,"textAlign":"left","textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"n17","name":"point-card-02","width":"fill_container","height":"fit_content","cornerRadius":24,"fill":"#FFFFFF","stroke":"#F2DFC7","strokeWidth":2,"layout":"horizontal","gap":24,"padding":[28,32],"alignItems":"start","children":[{"type":"frame","id":"n18","name":"point-badge-02","width":72,"height":72,"cornerRadius":36,"fill":"#C1560F","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"02","id":"n19","name":"point-num-02","fill":"#FFFFFF","fontFamily":"Inter","fontSize":30,"lineHeight":1.2,"letterSpacing":0,"textAlign":"center","fontWeight":"800"}]},{"type":"frame","id":"n20","name":"point-body-02","width":"fill_container","height":"fit_content","layout":"vertical","gap":10,"children":[{"type":"text","content":"时间是唯一的放大器","id":"n21","name":"point-title-02","width":"fill_container","fill":"#3A2415","fontFamily":"Noto Sans SC","fontSize":38,"lineHeight":1.35,"letterSpacing":0,"textAlign":"left","textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"同样的年化收益率，多坚持十年，结果不是多出一截，而是整整翻上好几倍。","id":"n22","name":"point-desc-02","width":"fill_container","fill":"#8A6A52","fontFamily":"Inter","fontSize":26,"lineHeight":1.75,"letterSpacing":0,"textAlign":"left","textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"n23","name":"point-card-03","width":"fill_container","height":"fit_content","cornerRadius":24,"fill":"#FFFFFF","stroke":"#F2DFC7","strokeWidth":2,"layout":"horizontal","gap":24,"padding":[28,32],"alignItems":"start","children":[{"type":"frame","id":"n24","name":"point-badge-03","width":72,"height":72,"cornerRadius":36,"fill":"#C1560F","layout":"horizontal","justifyContent":"center","alignItems":"center","children":[{"type":"text","content":"03","id":"n25","name":"point-num-03","fill":"#FFFFFF","fontFamily":"Inter","fontSize":30,"lineHeight":1.2,"letterSpacing":0,"textAlign":"center","fontWeight":"800"}]},{"type":"frame","id":"n26","name":"point-body-03","width":"fill_container","height":"fit_content","layout":"vertical","gap":10,"children":[{"type":"text","content":"中断一次，代价极高","id":"n27","name":"point-title-03","width":"fill_container","fill":"#3A2415","fontFamily":"Noto Sans SC","fontSize":38,"lineHeight":1.35,"letterSpacing":0,"textAlign":"left","textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"一次大亏或长期停摆会削掉复利的底数，补回来所需的时间，远比损失本身更贵。","id":"n28","name":"point-desc-03","width":"fill_container","fill":"#8A6A52","fontFamily":"Inter","fontSize":26,"lineHeight":1.75,"letterSpacing":0,"textAlign":"left","textGrowth":"fixed-width","fontWeight":"400"}]}]}]},{"type":"frame","id":"n29","name":"footer","width":"fill_container","height":"fit_content","layout":"vertical","gap":20,"children":[{"type":"rectangle","id":"n30","name":"footer-divider","width":"fill_container","height":2,"cornerRadius":1,"fill":"#EBD5B9"},{"type":"frame","id":"n31","name":"footer-row","width":"fill_container","height":"fit_content","layout":"horizontal","gap":24,"justifyContent":"space_between","alignItems":"center","children":[{"type":"frame","id":"n32","name":"signature","width":"fill_container","height":"fit_content","layout":"vertical","gap":10,"children":[{"type":"text","content":"@ 复利笔记","id":"n33","name":"signature-name","width":"fill_container","fill":"#3A2415","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.4,"letterSpacing":0,"textAlign":"left","textGrowth":"fixed-width","fontWeight":"700"},{"type":"text","content":"扫码关注 · 每周一则可复用的思维模型","id":"n34","name":"signature-sub","width":"fill_container","fill":"#8A6A52","fontFamily":"Noto Sans SC","fontSize":24,"lineHeight":1.5,"letterSpacing":0,"textAlign":"left","textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"n35","name":"qr-placeholder","width":116,"height":116,"cornerRadius":16,"fill":"#FFFFFF","stroke":"#E7D3BC","strokeWidth":2,"layout":"none","clip":true,"children":[{"type":"rectangle","id":"n36","name":"qr-finder-14-14","x":14,"y":14,"width":28,"height":28,"cornerRadius":6,"stroke":"#3A2415","strokeWidth":6},{"type":"rectangle","id":"n37","name":"qr-finder-74-14","x":74,"y":14,"width":28,"height":28,"cornerRadius":6,"stroke":"#3A2415","strokeWidth":6},{"type":"rectangle","id":"n38","name":"qr-finder-14-74","x":14,"y":74,"width":28,"height":28,"cornerRadius":6,"stroke":"#3A2415","strokeWidth":6},{"type":"rectangle","id":"n39","name":"qr-dot-52-16","x":52,"y":16,"width":9,"height":9,"cornerRadius":2,"fill":"#3A2415"},{"type":"rectangle","id":"n40","name":"qr-dot-52-32","x":52,"y":32,"width":9,