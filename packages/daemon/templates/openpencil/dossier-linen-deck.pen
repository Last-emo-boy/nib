dren":[{"type":"text","content":"44","id":"t134","name":"单元格文字","width":"fill_container","fill":"$c-ink","fontFamily":"Inter","fontSize":28,"lineHeight":1.45,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"frame","id":"f135","name":"单元格","width":320,"height":"fit_content","layout":"vertical","gap":0,"padding":[16,24],"children":[{"type":"text","content":"5.9","id":"t136","name":"单元格文字","width":"fill_container","fill":"$c-ink","fontFamily":"Inter","fontSize":28,"lineHeight":1.45,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"600"}]}]},{"type":"rectangle","id":"r138","name":"细线","width":1584,"height":1,"fill":"$c-rule"}]},{"type":"text","content":"数据来源：巡检系统 2026 年第二季度导出；判定口径见 §1.3。闭环率按「有整改记录且经复核」计，与月报一致。","id":"t140","name":"来源行","width":1584,"fill":"$c-ink-faint","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]},{"type":"frame","id":"f145","name":"编号段","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§2.1","id":"t143","name":"段号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.077,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f144","name":"段落","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"text","content":"巡检次数与上报条数几乎同步下降，闭环率却没有跟着走：\n东北片区巡到的次数最少，闭环时长反而最长 8.1 天。\n这说明瓶颈不在巡得够不够勤，而在巡完之后没人接得住。","id":"t142","name":"正文","width":900,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.8,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]}]}]},{"type":"frame","id":"f158","name":"03 现状数据 · 装订","width":1920,"height":1080,"layout":"none","children":[{"type":"rectangle","id":"r159","name":"装订孔","x":115,"y":264,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r160","name":"装订孔","x":115,"y":534,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r161","name":"装订孔","x":115,"y":804,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r162","name":"装订线","x":120,"y":0,"width":2,"height":1080,"fill":"$c-thread"}]}]},{"type":"frame","id":"f193","name":"04 分析","x":0,"y":1440,"width":1920,"height":1080,"fill":"$c-linen","layout":"none","clip":true,"children":[{"type":"frame","id":"f181","name":"04 分析 · 正文","width":1920,"height":1080,"layout":"vertical","gap":40,"padding":[96,120,96,0],"justifyContent":"start","children":[{"type":"frame","id":"f187","name":"正文块","width":"fill_container","height":"fit_content","layout":"vertical","gap":0,"padding":[0,0,0,216],"children":[{"type":"frame","id":"f186","name":"页眉","width":"fill_container","height":"fit_content","layout":"horizontal","gap":48,"justifyContent":"space_between","alignItems":"start","children":[{"type":"text","content":"OPS-2026-041","id":"t182","name":"文档代号","fill":"$c-ink-faint","fontFamily":"Inter","fontSize":26,"lineHeight":1.5,"letterSpacing":2,"textGrowth":"auto","fontWeight":"500"},{"type":"frame","id":"f185","name":"骑缝页标","width":"fit_content","height":"fit_content","layout":"vertical","gap":10,"alignItems":"end","children":[{"type":"text","content":"p. 4 / 8","id":"t183","name":"页标","fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"auto","fontWeight":"500"},{"type":"rectangle","id":"r184","name":"细线","width":48,"height":1,"fill":"$c-rule"}]}]}]},{"type":"frame","id":"f180","name":"节","width":"fill_container","height":"fit_content","layout":"vertical","gap":28,"children":[{"type":"frame","id":"f178","name":"节标题行","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§3","id":"t176","name":"节号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.115,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"text","content":"为什么抽查救不回来","id":"t177","name":"节标题","width":1584,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":44,"lineHeight":1.25,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"}]},{"type":"frame","id":"f179","name":"节内容","width":"fill_container","height":"fit_content","layout":"vertical","gap":28,"children":[{"type":"frame","id":"f170","name":"编号段","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§3.1","id":"t168","name":"段号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.077,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f169","name":"段落","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"text","content":"抽查的样本由排班决定，而排班避开了最难去的那些门店。\n越是偏远、越是人手紧的门店，被巡到的间隔越长，\n于是问题最多的地方，恰好是我们了解得最少的地方。\n这不是执行不力，是抽样方法自带的偏差。","id":"t167","name":"正文","width":900,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.8,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f174","name":"编号段","width":"fill_container","height":"fit_content","layout":"horizontal","gap":120,"alignItems":"start","children":[{"type":"text","content":"§3.2","id":"t172","name":"段号","width":96,"fill":"$c-thread","fontFamily":"Inter","fontSize":26,"lineHeight":2.077,"letterSpacing":0,"textAlign":"right","textGrowth":"fixed-width","fontWeight":"500"},{"type":"frame","id":"f173","name":"段落","width":"fill_container","height":"fit_content","layout":"vertical","gap":18,"children":[{"type":"text","content":"闭环率停在 44%，不是因为没人整改，\n而是因为整改完成后没有一个必须回填的动作。\n没有回填，就没有记录；没有记录，复算就无从谈起。","id":"t171","name":"正文","width":900,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.8,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]},{"type":"frame","id":"f175","name":"正文块","width":"fill_container","height":"fit_content","layout":"vertical","gap":0,"padding":[0,0,0,216],"children":[{"type":"frame","id":"f166","name":"引文块","width":1200,"height":"fit_content","fill":"$c-deep","layout":"vertical","gap":14,"padding":[32,40],"children":[{"type":"text","content":"我们不缺巡检，缺的是能被复算的巡检。","id":"t164","name":"引文","width":1100,"fill":"$c-ink","fontFamily":"Noto Sans SC","fontSize":30,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"600"},{"type":"text","content":"—— 华东区运营负责人，6 月复盘会记录","id":"t165","name":"引文出处","width":1100,"fill":"$c-ink-soft","fontFamily":"Noto Sans SC","fontSize":26,"lineHeight":1.5,"letterSpacing":0,"textGrowth":"fixed-width","fontWeight":"400"}]}]}]}]}]},{"type":"frame","id":"f188","name":"04 分析 · 装订","width":1920,"height":1080,"layout":"none","children":[{"type":"rectangle","id":"r189","name":"装订孔","x":115,"y":264,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r190","name":"装订孔","x":115,"y":534,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r191","name":"装订孔","x":115,"y":804,"width":12,"height":12,"fill":"$c-linen","stroke":"$c-rule","strokeWidth":1},{"type":"rectangle","id":"r192","name":"装订线","x":120,"y":0,"width":2,"height":1080,"fill":"$c-thread"}]}]},{"type":"frame","id":"f285","name":"05 方案对比","x":2040,"y":1440,"width":1920,"height":1080,"fill":"$c-linen","layout":"none","clip":true,"children":[{"type":"frame","id":"f273","name":"05 方案对比 · 正文","width":1920,"height":1080,"layout":"vertical","gap":40,"padding":[96,120,96,0],"justifyContent":"start","children":[{"type":"frame","id":"f279","name":"正文块","width":"fill_container","height":"fit_content","layout":"vertical","gap":0,"padding":[0,0,0,216],"children":[{"type":"fr